# Local build tag; use a verified image digest in production.
SERVICE_IMAGE=element-checker/service:local
POSTGRES_IMAGE=postgres:17@sha256:d74eeac9a635390a49bc21bd49fccd973de707e2a53a76ac49b552b8712ec46f
# Verified immutable gateway image; update deliberately and rerun smoke test.
NGINX_IMAGE=nginx:stable-alpine@sha256:ed84151ed2d47ef93c0939eb9b9754c6990db6092cd2081e11988a47a83d47ea
GATEWAY_BIND_ADDRESS=127.0.0.1
GATEWAY_PORT=8088
SERVICE_DATA_ROOT=/srv/element-autocheck/data
SCRIPT_RUNTIME_ROOT=/opt/element-script/10.0.2-1
DOCKER_SOCKET_PATH=/var/run/docker.sock
SECRETS_ROOT=./secrets
DEFAULT_MAX_CONCURRENT_CHECKS=2
MAX_CONCURRENT_CHECKS_HARD_LIMIT=8

# After publishing the built service image: sha256:<actual manifest digest>.
ENGINE_IMAGE_DIGEST=
