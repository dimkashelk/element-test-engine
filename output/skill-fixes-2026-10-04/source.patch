+from pathlib import Path
+import importlib.util
+import json
+import subprocess
+import sys
+
+import pytest
+
+
+ROOT = Path(__file__).resolve().parents[3]
+
+
+def load_validator():
+    spec = importlib.util.spec_from_file_location("profile_validator", ROOT / "skills/xbsl-validate/scripts/validate.py")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def project(root, version, name="Ключ", kind="КлючДоступа", extra=""):
+    root.mkdir(parents=True, exist_ok=True)
+    (root / "Проект.yaml").write_text(f'РежимСовместимости: "{version}" # exported mode\n', encoding="utf-8")
+    sub = root / "Основное"
+    sub.mkdir(exist_ok=True)
+    (sub / "Подсистема.yaml").write_text("", encoding="utf-8")
+    path = sub / f"{name}.yaml"
+    path.write_text(f"ВидЭлемента: {kind}\nИд: 10000000-0000-4000-8000-000000000001\nИмя: {name}\n" + extra, encoding="utf-8")
+    return path
+
+
+def diagnostics(validator, args, capsys):
+    code = validator.main(["--format", "json", *map(str, args)])
+    result = json.loads(capsys.readouterr().out)
+    return code, {d["rule_id"] for d in result["diagnostics"]}
+
+
+def test_mixed_projects_use_their_own_compatibility_profile(tmp_path, capsys):
+    old = project(tmp_path / "old", "9.0")
+    new = project(tmp_path / "new", "10.0")
+    validator = load_validator()
+    assert diagnostics(validator, [old], capsys) == (0, set())
+    assert diagnostics(validator, [new], capsys) == (1, {"owner.access_key.manual_grant_required"})
+    code, rules = diagnostics(validator, [old, new], capsys)
+    assert code == 1
+    assert rules == {"owner.access_key.manual_grant_required"}
+
+
+def test_legacy_profile_still_checks_invalid_access_key_values(tmp_path, capsys):
+    path = project(tmp_path, "9.0", extra="РучнаяВыдача: wrong\n")
+    code, rules = diagnostics(load_validator(), [path], capsys)
+    assert code == 1
+    assert "owner.access_key.boolean_literal" in rules
+    assert "owner.access_key.manual_grant_required" not in rules
+
+
+@pytest.mark.parametrize("version", ["9.0", "9.3"])
+def test_new_object_is_reported_as_unverified_in_legacy_profile(tmp_path, capsys, version):
+    path = project(tmp_path, version, kind="ЖурналДанных")
+    assert diagnostics(load_validator(), [path], capsys) == (0, {"coverage.version_unsupported"})
+
+
+def test_explicit_profile_cannot_override_student_project(tmp_path, capsys):
+    path = project(tmp_path, "9.0")
+    before = (tmp_path / "Проект.yaml").read_bytes()
+    assert diagnostics(load_validator(), [path, "--target-version", "10.0"], capsys) == (2, {"profile.invalid_version"})
+    assert (tmp_path / "Проект.yaml").read_bytes() == before
+
+
+@pytest.mark.parametrize("version", ["10.0.2-19", "wrong", "11.0"])
+def test_invalid_or_unverified_project_profile_fails_closed(tmp_path, capsys, version):
+    path = project(tmp_path, version)
+    assert diagnostics(load_validator(), [path], capsys) == (2, {"profile.invalid_version"})
+
+
+def test_fragment_profile_and_repeated_invocations_do_not_leak_state(tmp_path, capsys):
+    path = project(tmp_path, "9.0")
+    (tmp_path / "Проект.yaml").unlink()
+    validator = load_validator()
+    assert diagnostics(validator, [path, "--target-version=9.0"], capsys) == (0, set())
+    assert diagnostics(validator, [path, "--target-version=10.0"], capsys) == (1, {"owner.access_key.manual_grant_required"})
+    assert diagnostics(validator, [path, "--target-version=9.0"], capsys) == (0, set())
+
+
+def test_form_info_infers_legacy_hierarchy_and_refuses_conflicting_override(tmp_path):
+    path = project(tmp_path, "9.0", name="Категории", kind="Справочник", extra="Иерархический: Истина\n")
+    command = [sys.executable, str(ROOT / "skills/xbsl-form-info/scripts/form_info.py"), "--name", "Категории", "--root", str(tmp_path)]
+    result = subprocess.run(command, text=True, capture_output=True)
+    assert result.returncode == 0, result.stderr
+    data = json.loads(result.stdout)
+    assert data["target_version"] == "9.0"
+    assert data["hierarchy_kind"] == "ИерархияЭлементов"
+    assert data["parent_reference_type"] == "Категории.Ссылка?"
+    result = subprocess.run([*command, "--target-version", "10.0"], text=True, capture_output=True)
+    assert result.returncode == 1
+    assert json.loads(result.stdout)["rule_id"] == "profile.invalid_version"
+
+
+def test_card_generator_refuses_new_settings_before_any_write(tmp_path):
+    path = project(tmp_path, "9.0", name="Товары", kind="Справочник", extra="Реквизиты:\n    - Имя: Наименование\n      Тип: Строка\n")
+    original = path.read_bytes()
+    command = [sys.executable, str(ROOT / "skills/xbsl-form-cards/scripts/generate.py"), "--object", "Товары", "--root", str(tmp_path), "--settings-mode", "Расширенный", "--apply"]
+    result = subprocess.run(command, text=True, capture_output=True)
+    assert result.returncode == 1
+    assert "10.0" in result.stderr
+    assert path.read_bytes() == original
+    assert not (path.parent / "ТоварыФормаСписка.yaml").exists()
+
+
+def test_access_script_refuses_new_processing_rights_on_legacy_project(tmp_path):
+    path = project(tmp_path, "9.0", name="Обмен", kind="Обработка")
+    original = path.read_bytes()
+    command = [sys.executable, str(ROOT / "skills/xbsl-access-set/scripts/access_state.py"), "--object", "Обмен", "--root", str(tmp_path), "--set", "РазрешеноВсем", "--apply"]
+    result = subprocess.run(command, text=True, capture_output=True)
+    assert result.returncode == 1
+    assert "profile.unsupported_feature" in result.stderr
+    assert path.read_bytes() == original
+
+
+def test_legacy_report_keeps_old_required_query_parameter_contract(tmp_path, capsys):
+    path = project(tmp_path, "9.0", kind="Отчет", extra="ВидИсточникаДанных: Таблица\nИсточникДанных: Товары\nПараметрыЗапроса:\n    - Имя: Начало\n      Тип: ДатаВремя\n      Обязательный: Истина\n")
+    _, rules = diagnostics(load_validator(), [path], capsys)
+    assert "owner.report.layout_10" not in rules
+    (tmp_path / "Проект.yaml").write_text("РежимСовместимости: 10.0\n", encoding="utf-8")
+    _, rules = diagnostics(load_validator(), [path], capsys)
+    assert "owner.report.layout_10" in rules
