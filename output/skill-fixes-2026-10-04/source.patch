+"""Select the compatibility profile without changing project metadata."""
+
+from pathlib import Path
+import re
+
+
+VERSION_RE = re.compile(r"^[0-9]+\.[0-9]+$")
+
+
+def version_tuple(value: str) -> tuple[int, int]:
+    if not isinstance(value, str) or not VERSION_RE.fullmatch(value):
+        raise ValueError("Expected compatibility version <major>.<minor>")
+    return tuple(map(int, value.split(".")))
+
+
+def select_target_version(path: str | Path, explicit: str | None = None) -> str:
+    """Prefer the owning project; explicit target may fill missing metadata only.
+
+    Standalone snippets with no compatibility declaration retain the 10.0
+    reference profile. That fallback is unsuitable for grading student work.
+    """
+    if explicit is not None:
+        version_tuple(explicit)
+    path = Path(path).resolve()
+    directory = path if path.is_dir() else path.parent
+    detected = None
+    for parent in (directory, *directory.parents):
+        project = parent / "Проект.yaml"
+        if not project.is_file():
+            continue
+        text = project.read_text(encoding="utf-8-sig")
+        values = re.findall(r"(?m)^РежимСовместимости:[ \t]*(.*)$", text)
+        if len(values) > 1:
+            raise ValueError(f"Duplicate РежимСовместимости in {project}")
+        if values:
+            value = re.sub(r"\s+#.*$", "", values[0]).strip()
+            detected = value.strip("\"'")
+            version_tuple(detected)
+        break
+    if detected is not None and explicit is not None and version_tuple(detected) != version_tuple(explicit):
+        raise ValueError(f"Target {explicit} conflicts with project compatibility {detected}; project was not changed")
+    result = detected or explicit or "10.0"
+    if version_tuple(result)[0] not in (9, 10):
+        raise ValueError(f"Unsupported compatibility profile: {result}; supported families are 9.x and 10.x")
+    return result
