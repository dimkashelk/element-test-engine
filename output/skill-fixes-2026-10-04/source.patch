+#!/usr/bin/env python3
+"""Synchronize all xbsl skills and their shared docs, preserving other skills.
+
+Default is read-only; --apply creates a backup before replacing changed files.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import shutil
+import tempfile
+
+
+def digest(path: Path) -> str | None:
+    if path.is_symlink():
+        raise ValueError(f"Symlink is not an install target: {path}")
+    if path.exists() and not path.is_file():
+        raise ValueError(f"Expected a regular file: {path}")
+    return hashlib.sha256(path.read_bytes()).hexdigest() if path.exists() else None
+
+
+def reject_symlink_components(path: Path) -> None:
+    for entry in (path, *path.parents):
+        if entry.is_symlink():
+            raise ValueError(f"Symlink path is not supported: {entry}")
+
+
+def plan(source: Path, destination: Path) -> list[tuple[Path, Path, str | None]]:
+    reject_symlink_components(source)
+    reject_symlink_components(destination)
+    source = source.resolve()
+    destination = destination.resolve()
+    if destination.name != "skills":
+        raise ValueError("Destination must be a skills directory")
+    if source == destination.parent or source in destination.parents or destination in source.parents:
+        raise ValueError("Source repository and destination must not overlap")
+    skill_dirs = sorted(p for p in (source / "skills").glob("xbsl-*") if (p / "SKILL.md").is_file())
+    if len(skill_dirs) != 20:
+        raise ValueError("Source must contain all 20 xbsl skills")
+    files = []
+    for skill in skill_dirs:
+        for path in sorted(skill.rglob("*")):
+            if any(part in {"__pycache__", "runtime-evidence", "evidence"} for part in path.relative_to(skill).parts):
+                continue
+            if path.suffix in {".pyc", ".pyo"} or path.name == ".DS_Store":
+                continue
+            if path.is_symlink():
+                raise ValueError(f"Source symlinks are not supported: {path}")
+            if path.is_file():
+                files.append((path, destination / path.relative_to(source / "skills")))
+    spec = source / "docs" / "xbsl-spec.md"
+    if not spec.is_file():
+        raise ValueError("Shared docs/xbsl-spec.md is missing")
+    files.append((spec, destination.parent / "docs" / "xbsl-spec.md"))
+    changes = []
+    for path, target in files:
+        reject_symlink_components(target)
+        before = digest(target)
+        if before != digest(path) or (target.exists() and (target.stat().st_mode & 0o111) != (path.stat().st_mode & 0o111)):
+            changes.append((path, target, before))
+    return changes
+
+
+def main(argv=None) -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, default=Path(__file__).resolve().parents[1])
+    parser.add_argument("--destination", type=Path, default=Path(os.environ.get("CODEX_HOME", str(Path.home() / ".codex"))) / "skills")
+    mode = parser.add_mutually_exclusive_group()
+    mode.add_argument("--apply", action="store_true")
+    mode.add_argument("--check", action="store_true")
+    args = parser.parse_args(argv)
+    try:
+        changes = plan(args.source, args.destination)
+        result = {"changed_files": len(changes), "files": [str(target) for _, target, _ in changes]}
+        if args.apply and changes:
+            backup = Path(tempfile.mkdtemp(prefix="xbsl-skills-backup-"))
+            manifest = []
+            # Check every target before the first write, then back up all old bytes.
+            for _, target, before in changes:
+                if digest(target) != before:
+                    raise ValueError(f"Destination changed while planning: {target}")
+            for index, (_, target, before) in enumerate(changes):
+                saved = backup / str(index)
+                if before is not None:
+                    shutil.copy2(target, saved)
+                manifest.append({"path": str(target), "before_sha256": before, "backup": str(saved) if before is not None else None})
+            (backup / "manifest.json").write_text(json.dumps(manifest, ensure_ascii=False, indent=2), encoding="utf-8")
+            for path, target, before in changes:
+                if digest(target) != before:
+                    raise ValueError(f"Destination changed during installation: {target}; backup at {backup}")
+                target.parent.mkdir(parents=True, exist_ok=True)
+                fd, staged = tempfile.mkstemp(prefix=".xbsl-sync-", dir=target.parent)
+                os.close(fd)
+                try:
+                    shutil.copy2(path, staged)
+                    os.replace(staged, target)
+                finally:
+                    if os.path.exists(staged):
+                        os.unlink(staged)
+            result["backup"] = str(backup)
+        print(json.dumps(result, ensure_ascii=False, indent=2))
+        return 1 if args.check and changes else 0
+    except (OSError, ValueError) as error:
+        print(json.dumps({"error": str(error)}, ensure_ascii=False))
+        return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
