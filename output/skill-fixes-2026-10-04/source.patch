+from pathlib import Path
+import importlib.util
+import json
+
+
+SCRIPT = Path(__file__).resolve().parents[1] / "scripts/sync_xbsl_skills.py"
+
+
+def installer():
+    spec = importlib.util.spec_from_file_location("install_skills", SCRIPT)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def source_tree(tmp_path):
+    root = tmp_path / "repository"
+    for index in range(20):
+        skill = root / "skills" / f"xbsl-test-{index}"
+        skill.mkdir(parents=True)
+        (skill / "SKILL.md").write_text(f"skill {index}\n", encoding="utf-8")
+    (root / "docs").mkdir()
+    (root / "docs/xbsl-spec.md").write_text("shared specification\n", encoding="utf-8")
+    return root
+
+
+def test_install_is_explicit_backs_up_and_preserves_unrelated_skills(tmp_path, capsys):
+    source = source_tree(tmp_path)
+    destination = tmp_path / "codex" / "skills"
+    old = destination / "xbsl-test-0/SKILL.md"
+    old.parent.mkdir(parents=True)
+    old.write_text("old contents\n", encoding="utf-8")
+    unrelated = destination / "other-skill/SKILL.md"
+    unrelated.parent.mkdir()
+    unrelated.write_text("user skill\n", encoding="utf-8")
+    module = installer()
+    args = ["--source", str(source), "--destination", str(destination)]
+    assert module.main(args) == 0
+    assert old.read_text() == "old contents\n"
+    assert not (destination.parent / "docs/xbsl-spec.md").exists()
+    assert module.main([*args, "--check"]) == 1
+    capsys.readouterr()
+    assert module.main([*args, "--apply"]) == 0
+    result = json.loads(capsys.readouterr().out)
+    backup = json.loads((Path(result["backup"]) / "manifest.json").read_text())
+    saved = next(entry["backup"] for entry in backup if entry["path"] == str(old))
+    assert Path(saved).read_text() == "old contents\n"
+    assert old.read_text() == "skill 0\n"
+    assert unrelated.read_text() == "user skill\n"
+    assert (destination.parent / "docs/xbsl-spec.md").read_text() == "shared specification\n"
+    assert module.main([*args, "--check"]) == 0
+
+
+def test_missing_shared_spec_prevents_all_writes(tmp_path, capsys):
+    source = source_tree(tmp_path)
+    (source / "docs/xbsl-spec.md").unlink()
+    destination = tmp_path / "codex" / "skills"
+    assert installer().main(["--source", str(source), "--destination", str(destination), "--apply"]) == 2
+    assert not destination.exists()
+
+
+def test_install_refuses_symlinked_targets(tmp_path, capsys):
+    source = source_tree(tmp_path)
+    destination = tmp_path / "codex" / "skills"
+    old = destination / "xbsl-test-0/SKILL.md"
+    old.parent.mkdir(parents=True)
+    protected = tmp_path / "protected.md"
