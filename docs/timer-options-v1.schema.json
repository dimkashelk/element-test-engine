{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime.timers v1",
  "type": "object",
  "required": [
    "onClose"
  ],
  "additionalProperties": false,
  "properties": {
    "onClose": {
      "type": "string",
      "enum": [
        "cancel"
      ]
    },
    "maxEvents": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 1000
    }
  }
}
