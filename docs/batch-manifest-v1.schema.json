{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:element-test:batch-manifest:v1",
  "title": "Batch manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assignment", "assignmentId", "submissions"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "assignment": {"type": "string", "minLength": 1},
    "assignmentId": {"$ref": "#/$defs/identifier"},
    "submissions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["studentId", "project"],
        "properties": {
          "studentId": {"$ref": "#/$defs/identifier"},
          "project": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"}
  }
}
