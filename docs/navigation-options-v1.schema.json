{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "runtime.navigation v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "navigation": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string"
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "projectSourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "navigation"
  ],
  "additionalProperties": false
}
