метод Computed(): Объект
    возврат Запрос{ВЫБРАТЬ Label + "!" КАК Text, Amount * 2 + 0.1 + 0.2 КАК Double, ВЫБОР КОГДА Flag ТОГДА Amount ИНАЧЕ 0 КОНЕЦ КАК Choice, Label.Подстрока(0, 1) КАК Prefix, Day.ДобавитьДни(1) КАК Tomorrow ИЗ Data::Item УПОРЯДОЧИТЬ ПО Text}.Выполнить()
;
метод Aggregate(): Объект
    возврат Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Count, СУММА(Amount) КАК Sum, МИНИМУМ(Amount) КАК Min, МАКСИМУМ(Amount) КАК Max, СРЕДНЕЕ(Amount) КАК Avg ИЗ Data::Item}.Выполнить()
;
метод Grouped(): Объект
    возврат Запрос{ВЫБРАТЬ Key, КОЛИЧЕСТВО(*) КАК Count, СУММА(Amount) КАК Sum ИЗ Data::Item СГРУППИРОВАТЬ ПО Key УПОРЯДОЧИТЬ ПО Key}.Выполнить()
;
метод Having(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Key, СУММА(Amount) КАК Sum ИЗ Data::Item ГДЕ Amount > 0 СГРУППИРОВАТЬ ПО Key ИМЕЮЩИЕ СУММА(Amount) >= 4 УПОРЯДОЧИТЬ ПО Sum УБЫВ}.Выполнить()
;
метод Distinct(): Объект
    возврат Запрос{ВЫБРАТЬ РАЗЛИЧНЫЕ Key ИЗ Data::Item УПОРЯДОЧИТЬ ПО Key}.Выполнить()
;
метод DistinctAggregate(): Объект
    возврат Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Key) КАК Count, СУММА(РАЗЛИЧНЫЕ Amount) КАК Sum, СРЕДНЕЕ(РАЗЛИЧНЫЕ Amount) КАК Avg ИЗ Data::Item}.Выполнить()
;
метод JoinGroup(): Объект
    возврат Запрос{ВЫБРАТЬ A.Key, КОЛИЧЕСТВО(*) КАК Rows, КОЛИЧЕСТВО(B.Amount) КАК Present, СУММА(B.Amount) КАК Sum, СУММА(B.Amount.ЗаменитьNull(0)) КАК Safe ИЗ Data::Item КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Item КАК B ПО A.Key == B.Key СГРУППИРОВАТЬ ПО A.Key УПОРЯДОЧИТЬ ПО A.Key}.Выполнить()
;
метод NullGroup(): Объект
    возврат Запрос{ВЫБРАТЬ B.Label КАК Name, КОЛИЧЕСТВО(*) КАК Count ИЗ Data::Item КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Item КАК B ПО A.Key == B.Key СГРУППИРОВАТЬ ПО B.Label}.Выполнить()
;
метод NullDistinct(): Объект
    возврат Запрос{ВЫБРАТЬ РАЗЛИЧНЫЕ B.Label КАК Name ИЗ Data::Item КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Item КАК B ПО A.Key == B.Key}.Выполнить()
;
метод Case(): Объект
    возврат Запрос{ВЫБРАТЬ Key, ВЫБОР Key КОГДА 1 ТОГДА "one" КОГДА 2 ТОГДА "two" КОНЕЦ КАК Name, ВЫБОР КОГДА Amount == 0 ТОГДА 0 ИНАЧЕ 10 / Amount КОНЕЦ КАК Quotient ИЗ Data::Item}.Выполнить()
;
метод Cast(): Объект
    возврат Запрос{ВЫБРАТЬ ВЫРАЗИТЬ(Amount КАК Число(5, 2)) КАК Rounded, ВЫРАЗИТЬ(Label КАК Строка(1)) КАК Text ИЗ Data::Item}.Выполнить()
;
метод Typed(): Объект
    возврат Запрос{ВЫБРАТЬ Peer, Kind, КОЛИЧЕСТВО(*) КАК Count ИЗ Data::Item СГРУППИРОВАТЬ ПО Peer, Kind}.Выполнить()
;
метод Fill(): Объект
    возврат Запрос{ВЫБРАТЬ Key, СУММА(Amount) КАК Sum ЗАПОЛНИТЬ Data::Card ИЗ Data::Item СГРУППИРОВАТЬ ПО Key}.Выполнить()
;
метод Params(Bonus: Число, Threshold: Число, Min: Число): Объект
    возврат Запрос{ВЫБРАТЬ Key, СУММА(Amount + %Bonus) КАК Sum ИЗ Data::Item ГДЕ Key >= %Threshold СГРУППИРОВАТЬ ПО Key ИМЕЮЩИЕ СУММА(Amount + %Bonus) > %Min УПОРЯДОЧИТЬ ПО Sum}.Выполнить()
;
метод GroupedExpression(): Объект
    возврат Запрос{ВЫБРАТЬ Key * 2 КАК K, КОЛИЧЕСТВО(*) КАК Count ИЗ Data::Item СГРУППИРОВАТЬ ПО Key * 2}.Выполнить()
;
метод NullUndefined(): Объект
    возврат Запрос{ВЫБРАТЬ ВЫБОР КОГДА Key == 1 ТОГДА NULL ИНАЧЕ Peer КОНЕЦ КАК Value, КОЛИЧЕСТВО(*) КАК Count ИЗ Data::Item СГРУППИРОВАТЬ ПО ВЫБОР КОГДА Key == 1 ТОГДА NULL ИНАЧЕ Peer КОНЕЦ}.Выполнить()
;
метод CountUndefined(): Объект
    возврат Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(Peer) КАК DefinedRows, КОЛИЧЕСТВО(NULL) КАК NullRows ИЗ Data::Item}.Выполнить()
;
метод Precision(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 ВЫРАЗИТЬ(1.005 КАК Число(1, 2)) КАК Positive, ВЫРАЗИТЬ(-1.005 КАК Число(1, 2)) КАК Negative, 0.1000000000000000000001 + 0.2000000000000000000002 КАК Exact, 5 % 2 КАК Remainder ИЗ Data::Item}.Выполнить()
;
метод DistinctLimit(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 2 РАЗЛИЧНЫЕ Amount КАК Value ИЗ Data::Item УПОРЯДОЧИТЬ ПО Value УБЫВ}.Выполнить()
;
метод Unsupported(): Объект
    возврат Запрос{ВЫБРАТЬ СУММА(Amount) КАК Sum ИЗ Data::Item ОБЪЕДИНИТЬ ВЫБРАТЬ Label ИЗ Data::Item}.Выполнить()
;
метод Capture(Calls: Массив<Строка>, N: Число): Число
    Calls.Добавить("capture")
    возврат N
;
метод State(): Объект
    знч Calls = новый Массив<Строка>()
    знч Q = Запрос{ВЫБРАТЬ СУММА(Amount + %{Capture(Calls, 1)}) КАК Sum ИЗ Data::Item}
    знч Old = Q.Выполнить()
    пер Seen: Объект = новый Массив<Объект>()
    попытка
        исп Транзакции.Начать()
        знч V = новый Data::Item.Объект(Ссылка = Data::Item.ПолучитьСсылку(новый Ууид("11111111-1111-4111-8111-111111111111")), Key = 1, Amount = 20, Label = "a", Day = новый Дата(2024, 2, 28))
        V.Записать()
        Seen = Q.Выполнить()
        выбросить новый ИсключениеВалидации("rollback")
    поймать E: ИсключениеВалидации
        возврат {"old": Old, "seen": Seen, "after": Q.Выполнить(), "calls": Calls}
    ;
;
