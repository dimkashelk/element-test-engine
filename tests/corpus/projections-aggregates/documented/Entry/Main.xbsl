метод ComputedProjection(): Объект
    возврат Запрос{ВЫБРАТЬ Total * 2 КАК Double ИЗ Data::Item
}.Выполнить()
;
метод Group(): Объект
    возврат Запрос{ВЫБРАТЬ Label, СУММА(Total) ИЗ Data::Item СГРУППИРОВАТЬ ПО Label
}.Выполнить()
;
метод Having(): Объект
    возврат Запрос{ВЫБРАТЬ Label, СУММА(Total) ИЗ Data::Item СГРУППИРОВАТЬ ПО Label ИМЕЮЩИЕ СУММА(Total) > 0
}.Выполнить()
;
метод Case(): Объект
    возврат Запрос{ВЫБРАТЬ ВЫБОР КОГДА Flag ТОГДА Total ИНАЧЕ 0 КОНЕЦ КАК Value ИЗ Data::Item
}.Выполнить()
;
метод CombinedJoinGroupNull(): Объект
    возврат Запрос{ВЫБРАТЬ A.Label, СУММА(B.Total.ЗаменитьNull(0)) ИЗ Data::Item КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Item КАК B ПО A.Key == B.Key СГРУППИРОВАТЬ ПО A.Label
}.Выполнить()
;
