метод Computed(): Объект
    возврат Запрос{ВЫБРАТЬ Label + "!" КАК Text, Значение * 2 + 0.1 + 0.2 КАК Double, ВЫБОР КОГДА Flag ТОГДА Значение ИНАЧЕ 0 КОНЕЦ КАК Choice, Label.Подстрока(0, 1) КАК Prefix, Day.ДобавитьДни(1) КАК Tomorrow ИЗ Учет::Строки УПОРЯДОЧИТЬ ПО Text}.Выполнить()
;
метод Aggregate(): Объект
    возврат Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Count, СУММА(Значение) КАК Sum, МИНИМУМ(Значение) КАК Min, МАКСИМУМ(Значение) КАК Max, СРЕДНЕЕ(Значение) КАК Avg ИЗ Учет::Строки}.Выполнить()
;
метод Grouped(): Объект
    возврат Запрос{ВЫБРАТЬ Номер, КОЛИЧЕСТВО(*) КАК Count, СУММА(Значение) КАК Sum ИЗ Учет::Строки СГРУППИРОВАТЬ ПО Номер УПОРЯДОЧИТЬ ПО Номер}.Выполнить()
;
метод Having(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Номер, СУММА(Значение) КАК Sum ИЗ Учет::Строки ГДЕ Значение > 0 СГРУППИРОВАТЬ ПО Номер ИМЕЮЩИЕ СУММА(Значение) >= 4 УПОРЯДОЧИТЬ ПО Sum УБЫВ}.Выполнить()
;
метод Distinct(): Объект
    возврат Запрос{ВЫБРАТЬ РАЗЛИЧНЫЕ Номер ИЗ Учет::Строки УПОРЯДОЧИТЬ ПО Номер}.Выполнить()
;
метод DistinctAggregate(): Объект
    возврат Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Номер) КАК Count, СУММА(РАЗЛИЧНЫЕ Значение) КАК Sum, СРЕДНЕЕ(РАЗЛИЧНЫЕ Значение) КАК Avg ИЗ Учет::Строки}.Выполнить()
;
метод JoinGroup(): Объект
    возврат Запрос{ВЫБРАТЬ A.Номер, КОЛИЧЕСТВО(*) КАК Rows, КОЛИЧЕСТВО(B.Значение) КАК Present, СУММА(B.Значение) КАК Sum, СУММА(B.Значение.ЗаменитьNull(0)) КАК Safe ИЗ Учет::Строки КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Строки КАК B ПО A.Номер == B.Номер СГРУППИРОВАТЬ ПО A.Номер УПОРЯДОЧИТЬ ПО A.Номер}.Выполнить()
;
метод NullGroup(): Объект
    возврат Запрос{ВЫБРАТЬ B.Label КАК Name, КОЛИЧЕСТВО(*) КАК Count ИЗ Учет::Строки КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Строки КАК B ПО A.Номер == B.Номер СГРУППИРОВАТЬ ПО B.Label}.Выполнить()
;
метод NullDistinct(): Объект
    возврат Запрос{ВЫБРАТЬ РАЗЛИЧНЫЕ B.Label КАК Name ИЗ Учет::Строки КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Строки КАК B ПО A.Номер == B.Номер}.Выполнить()
;
метод Case(): Объект
    возврат Запрос{ВЫБРАТЬ Номер, ВЫБОР Номер КОГДА 1 ТОГДА "one" КОГДА 2 ТОГДА "two" КОНЕЦ КАК Name, ВЫБОР КОГДА Значение == 0 ТОГДА 0 ИНАЧЕ 10 / Значение КОНЕЦ КАК Quotient ИЗ Учет::Строки}.Выполнить()
;
метод Cast(): Объект
    возврат Запрос{ВЫБРАТЬ ВЫРАЗИТЬ(Значение КАК Число(5, 2)) КАК Rounded, ВЫРАЗИТЬ(Label КАК Строка(1)) КАК Text ИЗ Учет::Строки}.Выполнить()
;
метод Typed(): Объект
    возврат Запрос{ВЫБРАТЬ Peer, Kind, КОЛИЧЕСТВО(*) КАК Count ИЗ Учет::Строки СГРУППИРОВАТЬ ПО Peer, Kind}.Выполнить()
;
метод Fill(): Объект
    возврат Запрос{ВЫБРАТЬ Номер, СУММА(Значение) КАК Sum ЗАПОЛНИТЬ Учет::Card ИЗ Учет::Строки СГРУППИРОВАТЬ ПО Номер}.Выполнить()
;
метод Params(Bonus: Число, Threshold: Число, Min: Число): Объект
    возврат Запрос{ВЫБРАТЬ Номер, СУММА(Значение + %Bonus) КАК Sum ИЗ Учет::Строки ГДЕ Номер >= %Threshold СГРУППИРОВАТЬ ПО Номер ИМЕЮЩИЕ СУММА(Значение + %Bonus) > %Min УПОРЯДОЧИТЬ ПО Sum}.Выполнить()
;
метод GroupedExpression(): Объект
    возврат Запрос{ВЫБРАТЬ Номер * 2 КАК K, КОЛИЧЕСТВО(*) КАК Count ИЗ Учет::Строки СГРУППИРОВАТЬ ПО Номер * 2}.Выполнить()
;
метод NullUndefined(): Объект
    возврат Запрос{ВЫБРАТЬ ВЫБОР КОГДА Номер == 1 ТОГДА NULL ИНАЧЕ Peer КОНЕЦ КАК Value, КОЛИЧЕСТВО(*) КАК Count ИЗ Учет::Строки СГРУППИРОВАТЬ ПО ВЫБОР КОГДА Номер == 1 ТОГДА NULL ИНАЧЕ Peer КОНЕЦ}.Выполнить()
;
метод CountUndefined(): Объект
    возврат Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(Peer) КАК DefinedRows, КОЛИЧЕСТВО(NULL) КАК NullRows ИЗ Учет::Строки}.Выполнить()
;
метод Precision(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 ВЫРАЗИТЬ(1.005 КАК Число(1, 2)) КАК Positive, ВЫРАЗИТЬ(-1.005 КАК Число(1, 2)) КАК Negative, 0.1000000000000000000001 + 0.2000000000000000000002 КАК Exact, 5 % 2 КАК Remainder ИЗ Учет::Строки}.Выполнить()
;
метод DistinctLimit(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 2 РАЗЛИЧНЫЕ Значение КАК Value ИЗ Учет::Строки УПОРЯДОЧИТЬ ПО Value УБЫВ}.Выполнить()
;
метод Unsupported(): Объект
    возврат Запрос{ВЫБРАТЬ СУММА(Значение) КАК Sum ИЗ Учет::Строки ОБЪЕДИНИТЬ ВЫБРАТЬ Label ИЗ Учет::Строки}.Выполнить()
;
метод Capture(Calls: Массив<Строка>, N: Число): Число
    Calls.Добавить("capture")
    возврат N
;
метод State(): Объект
    знч Calls = новый Массив<Строка>()
    знч Q = Запрос{ВЫБРАТЬ СУММА(Значение + %{Capture(Calls, 1)}) КАК Sum ИЗ Учет::Строки}
    знч Old = Q.Выполнить()
    пер Seen: Объект = новый Массив<Объект>()
    попытка
        исп Транзакции.Начать()
        знч V = новый Учет::Строки.Объект(Ссылка = Учет::Строки.ПолучитьСсылку(новый Ууид("11111111-1111-4111-8111-111111111111")), Номер = 1, Значение = 20, Label = "a", Day = новый Дата(2024, 2, 28))
        V.Записать()
        Seen = Q.Выполнить()
        выбросить новый ИсключениеВалидации("rollback")
    поймать E: ИсключениеВалидации
        возврат {"old": Old, "seen": Seen, "after": Q.Выполнить(), "calls": Calls}
    ;
;
