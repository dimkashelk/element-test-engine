метод Math(): Объект
    возврат Запрос{ВЫБРАТЬ ACos(-1) КАК A, ASin(1) КАК B, ATan(1) КАК C, Cos(15) КАК D, Sin(15) КАК E, Tan(0.8) КАК F, Exp(5) КАК G, Log(10) КАК H, Log10(100) КАК I, Степень(2,6) КАК J, 2.1 ** 3 КАК K, Корень(64) КАК L, 2 ** -10 КАК M ИЗ Other::Item}.Выполнить()
;
метод First(): Объект
    возврат Запрос{ВЫБРАТЬ A.Key, ПервыйНеNull(B.Amount, 9, 10 / 0) КАК Value ИЗ Data::Item КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Item КАК B ПО A.Key == B.Key УПОРЯДОЧИТЬ ПО A.Amount}.Выполнить()
;
метод AllNull(): Объект
    возврат Запрос{ВЫБРАТЬ ПервыйНеNull(NULL, NULL) КАК Value ИЗ Other::Item}.Выполнить()
;
метод OptionalValue(): Объект
    возврат Запрос{ВЫБРАТЬ ПервыйНеNull(Peer, NULL) КАК Value ИЗ Data::Item УПОРЯДОЧИТЬ ПО Amount}.Выполнить()
;
метод Match(Pattern: Строка): Объект
    возврат Запрос{ВЫБРАТЬ Label, Label.ПолноеСовпадение(%Pattern) КАК Match ИЗ Data::Item УПОРЯДОЧИТЬ ПО Label}.Выполнить()
;
метод DateParts(): Объект
    возврат Запрос{ВЫБРАТЬ Day.Год КАК Year, Day.Месяц КАК Month, Day.День КАК Day, КОЛИЧЕСТВО(*) КАК Count ИЗ Data::Item СГРУППИРОВАТЬ ПО Day.Год, Day.Месяц, Day.День}.Выполнить()
;
метод TempFields(): Объект
    возврат Запрос{СОЗДАТЬ ВРЕМЕННУЮ ТАБЛИЦУ T (Id АвтоНомерЗаписи, Qty: Число(3, 1), Price: Число(3, 2) ПО УМОЛЧАНИЮ 2.555, Amount: Число(5, 2) ПО УМОЛЧАНИЮ Qty * Price, Calc ВЫЧИСЛЯЕТСЯ КАК Qty * Price, Label: Строка(3) ПО УМОЛЧАНИЮ "abcdef", Optional: Строка?);
 ВСТАВИТЬ В T (Qty) ЗНАЧЕНИЯ (2.34);
 ВСТАВИТЬ В T (Qty, Amount, Label) ЗНАЧЕНИЯ (1, 99.995, "xy");
 ИЗМЕНИТЬ T УСТАНОВИТЬ Qty = 4.26 ГДЕ Id == 1;
 СОЗДАТЬ ИНДЕКС I ДЛЯ T (Id) ДОПОЛНИТЕЛЬНО ПО (Amount);
 ВЫБРАТЬ Id, Qty, Price, Amount, Calc, Label, Optional ИЗ T УПОРЯДОЧИТЬ ПО Id}.Выполнить()
;
метод TempSelect(): Объект
    возврат Запрос{СОЗДАТЬ ВРЕМЕННУЮ ТАБЛИЦУ T (Id АвтоНомерЗаписи, Qty: Число(3, 1), Price: Число(3, 2) ПО УМОЛЧАНИЮ 2.555, Amount: Число(5, 2) ПО УМОЛЧАНИЮ Qty * Price);
 ВСТАВИТЬ В T (Qty) ВЫБРАТЬ Amount ИЗ Data::Item УПОРЯДОЧИТЬ ПО Label;
 ВЫБРАТЬ Id, Qty, Amount ИЗ T УПОРЯДОЧИТЬ ПО Id}.Выполнить()
;
метод TempCapture(): Объект
    знч Calls = новый Массив<Число>()
    знч Q = Запрос{СОЗДАТЬ ВРЕМЕННУЮ ТАБЛИЦУ T (Qty: Число, Price: Число ПО УМОЛЧАНИЮ 2, Amount: Число ПО УМОЛЧАНИЮ Qty * Price);
 ВСТАВИТЬ В T (Qty) ЗНАЧЕНИЯ (%{Capture(Calls)});
 ВЫБРАТЬ Qty, Amount ИЗ T}
    знч First = Q.Выполнить()
    возврат {"first": First, "again": Q.Выполнить(), "calls": Calls.Размер()}
;
метод TempLife(): Объект
    знч Q = Запрос{СОЗДАТЬ ВРЕМЕННУЮ ТАБЛИЦУ T (Id АвтоНомерЗаписи, Value: Строка(0));
 ВСТАВИТЬ В T (Value) ЗНАЧЕНИЯ ("one");
 УДАЛИТЬ ИЗ T;
 ВСТАВИТЬ В T (Value) ЗНАЧЕНИЯ ("two");
 ВЫБРАТЬ Id, Value ИЗ T}
    знч First = Q.Выполнить()
    возврат {"first": First, "again": Q.Выполнить()}
;
метод NullDefaults(): Объект
    возврат Запрос{СОЗДАТЬ ВРЕМЕННУЮ ТАБЛИЦУ T (Id АвтоНомерЗаписи, Value: Строка? ПО УМОЛЧАНИЮ "fallback");
 ВСТАВИТЬ В T (Value) ЗНАЧЕНИЯ (NULL);
 ВСТАВИТЬ В T (Value) ЗНАЧЕНИЯ (Неопределено);
 ВЫБРАТЬ Id, Value, Value ЕСТЬ NULL КАК Missing ИЗ T УПОРЯДОЧИТЬ ПО Id}.Выполнить()
;
метод Unsupported(): Объект
    возврат Запрос{ВЫБРАТЬ Key ИЗ Data::Item ОБЪЕДИНИТЬ ВЫБРАТЬ Label ИЗ Other::Item}.Выполнить()
;
метод join_left_join(): Объект
    возврат Запрос{ВЫБРАТЬ A.Label ИЗ Data::Item КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Item КАК B ПО A.Key == B.Key}.Выполнить()
;
метод join_inner_join(): Объект
    возврат Запрос{ВЫБРАТЬ A.Label ИЗ Data::Item КАК A ВНУТРЕННЕЕ СОЕДИНЕНИЕ Other::Item КАК B ПО A.Key == B.Key}.Выполнить()
;
метод join_right_join(): Объект
    возврат Запрос{ВЫБРАТЬ A.Label ИЗ Data::Item КАК A ПРАВОЕ СОЕДИНЕНИЕ Other::Item КАК B ПО A.Key == B.Key}.Выполнить()
;
метод join_full_join(): Объект
    возврат Запрос{ВЫБРАТЬ A.Label ИЗ Data::Item КАК A ПОЛНОЕ СОЕДИНЕНИЕ Other::Item КАК B ПО A.Key == B.Key}.Выполнить()
;
метод join_nullable(): Объект
    возврат Запрос{ВЫБРАТЬ Optional ИЗ Data::Item ГДЕ Optional ЕСТЬ NULL}.Выполнить()
;
метод join_replace_null(): Объект
    возврат Запрос{ВЫБРАТЬ Optional.ЗаменитьNull("") КАК Value ИЗ Data::Item}.Выполнить()
;
метод Capture(Calls: Массив<Число>): Число
    Calls.Добавить(3)
    возврат 3
;
метод Uuid(): Объект
    знч Q = Запрос{ВЫБРАТЬ Ууид() КАК Id ИЗ Data::Item}
    знч First = Q.Выполнить()
    знч Again = Q.Выполнить()
    знч Unique = новый Массив<Ууид>()
    пер Fresh = Истина
    для R из First
        если не Unique.Содержит(R.Id)
            Unique.Добавить(R.Id)
        ;
        для S из Again
            если R.Id == S.Id
                Fresh = Ложь
            ;
        ;
    ;
    возврат {"count": First.Размер(), "distinct": Unique.Размер() == First.Размер(), "fresh": Fresh}
;
