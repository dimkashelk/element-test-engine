импорт B::Math как Helper
конст Множитель = 2
метод Run(X: Число): Число
    если X < 0
        возврат Crash()
    ;
    знч Callback = &Helper.C
    возврат B(X) * Множитель + Callback(X)
;
метод B(X: Число): Число
    возврат Helper.C(X) + 1
;
метод Crash(): Число
    выбросить новый ИсключениеНедопустимоеСостояние("bad branch")
;
метод Unknown(): Число
    возврат Missing()
;
метод Void()
;
