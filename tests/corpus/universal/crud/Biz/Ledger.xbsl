метод Write(ID: Строка, Name: Строка, Amount: Число): Ledger.Ссылка
    знч O = новый Ledger.Объект(Ссылка = ПолучитьСсылку(ID), Name = Name, Total = Amount)
    O.Rows.Добавить(новый Ledger.Rows(Amount = Amount))
    O.Записать()
    возврат O.Ссылка
;
метод Read(ID: Строка): Ledger.Объект?
    возврат ПолучитьСсылку(ID).ЗагрузитьОбъект()
;
метод Fresh(ID: Строка): Число
    знч Ref = ПолучитьСсылку(ID)
    знч O = Ref.ЗагрузитьОбъект() как Ledger.Объект
    O.Total = 999
    возврат (Ref.ЗагрузитьОбъект() как Ledger.Объект).Total
;
метод Broken(ID: Строка)
    Write(ID, "partial", 8)
    выбросить новый ИсключениеНедопустимоеСостояние("rollback")
;

метод Lock(ID: Строка): Ledger.Объект?
    возврат ПолучитьСсылку(ID).ЗагрузитьОбъект(Истина)
;

метод UnsupportedResource(ID: Строка): Число
    исп Handle = Транзакции.Начать()
    Handle.Фиксировать()
    возврат 1
;
