метод Сохранить(ID: Ууид, Название: Строка, Цена: Число): Акт.Ссылка
    знч O = новый Акт.Объект(Ссылка = ПолучитьСсылку(ID), Название = Название, Баланс = Цена)
    O.Позиции.Добавить(новый Акт.Позиции(Цена = Цена))
    O.Записать()
    возврат O.Ссылка
;
метод Прочитать(ID: Ууид): Акт.Объект?
    возврат ПолучитьСсылку(ID).ЗагрузитьОбъект()
;
метод СвежийСнимок(ID: Ууид): Число
    знч Ref = ПолучитьСсылку(ID)
    знч O = Ref.ЗагрузитьОбъект() как Акт.Объект
    O.Баланс = 999
    возврат (Ref.ЗагрузитьОбъект() как Акт.Объект).Баланс
;
метод ОшибкаЗаписи(ID: Ууид)
    Сохранить(ID, "partial", 8)
    выбросить новый ИсключениеНедопустимоеСостояние("rollback")
;

метод Lock(ID: Ууид): Акт.Объект?
    возврат ПолучитьСсылку(ID).ЗагрузитьОбъект(Истина)
;

метод UnsupportedResource(ID: Ууид): Число
    исп Handle = Транзакции.Начать()
    Handle.Фиксировать()
    возврат 1
;
