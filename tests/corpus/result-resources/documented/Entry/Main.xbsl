метод fill(): Объект
    возврат Запрос{ВЫБРАТЬ Label КАК Name ЗАПОЛНИТЬ Data::Card ИЗ Data::Item}.Выполнить().ВМассив()
;
метод generate(): Объект
    возврат Запрос{ВЫБРАТЬ Label ПОРОДИТЬ Row ИЗ Data::Item}.Выполнить().ВМассив()
;
метод result_resources(): Объект?
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item}.Выполнить().ЕдинственныйИлиНеопределено()
;
метод combined_fill_slice_order(D: Дата): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 Label КАК Name ЗАПОЛНИТЬ Data::Card ИЗ Data::Book.СрезПоследних(%D) УПОРЯДОЧИТЬ ПО Total}.Выполнить().ВМассив()
;
