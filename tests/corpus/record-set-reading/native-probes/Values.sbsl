структура Ref
    пер ID: Ууид
;
структура Row
    пер Period: Дата
    пер Link: Ref
    пер N: Число
;
метод Скрипт()
    знч Rows = [новый Row(Period = новый Дата(2026, 9, 30), Link = новый Ref(ID = новый Ууид("12345678-1234-4234-8234-123456789abc")), N = 2)]
    знч JSON = СериализацияJson.ЗаписатьОбъект(Rows)
    знч Copy = СериализацияJson.ПрочитатьОбъект<Массив<Row>>(JSON, Rows.ПолучитьТип())
    для R из Copy
        R.N *= 3
        R.Link.ID = новый Ууид("33333333-1234-4234-8234-123456789abc")
    ;
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"original": Rows, "copy": Copy, "dateEqual": Rows[0].Period == новый Дата("2026-09-30")}))
;
