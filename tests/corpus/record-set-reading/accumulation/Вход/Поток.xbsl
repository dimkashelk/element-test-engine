импорт Учет::Движения как Книга
импорт Учет::Акт как Док
метод Перенести(Из: Док.Ссылка, В: Док.Ссылка, Множитель: Число)
    знч Набор = новый Книга.НаборЗаписей()
    Набор.Фильтр.Установить(Регистратор = Из)
    Набор.Прочитать()
    для СтрокаНабора из Набор
        СтрокаНабора.Количество *= Множитель
        СтрокаНабора.Регистратор = В
    ;
    Набор.Фильтр.Установить(Регистратор = В)
    Набор.Записать()
;
метод Прочесть(Из: Док.Ссылка): Объект
    знч Набор = новый Книга.НаборЗаписей()
    Набор.Фильтр.Установить(Регистратор = Из)
    Набор.Прочитать()
    возврат Набор.Записи
;
метод Недоступно()
    знч Набор = новый Книга.НаборЗаписей()
    Набор.Фильтр.Установить()
    Набор.Прочитать()
;
