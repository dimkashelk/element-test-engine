@Обработчик
метод ПриСозданииНаОсновании(Основание: Отгрузка.Ссылка)
    знч ИсходнаяОтгрузка = Основание.ЗагрузитьОбъект()
    Склад = ИсходнаяОтгрузка.Склад
    для Элемент из ИсходнаяОтгрузка.Товары
        знч НоваяСтрока = новый ПоступлениеТоваров.Товары(
            Номенклатура = Элемент.Номенклатура,
            Количество = Элемент.Количество,
            Цена = Элемент.Цена,
            Сумма = Элемент.Сумма)
        этот.Товары.Добавить(НоваяСтрока)
    ;
;

