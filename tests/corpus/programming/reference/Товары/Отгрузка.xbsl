@ВПроекте
@ДоступноСКлиента
@НаСервере
метод СоздатьЧасть(Параметр: Массив<Продажи::Заказ.Товары>): Отгрузка.Объект
    знч НовыйДокумент = новый Отгрузка.Объект()
    ПеренестиТабличнуюЧасть(Параметр, НовыйДокумент)
    возврат НовыйДокумент
;

@ВПодсистеме
метод ПеренестиТабличнуюЧасть(ДляПереноса: Массив<Продажи::Заказ.Товары>, Документ: Отгрузка.Объект)
    для Элемент из ДляПереноса
        знч НоваяСтрока = новый Отгрузка.Товары(
            Номенклатура = Элемент.Номенклатура,
            Количество = Элемент.Количество,
            Цена = Элемент.Цена,
            Сумма = Элемент.Сумма)
        Документ.Товары.Добавить(НоваяСтрока)
    ;
;
