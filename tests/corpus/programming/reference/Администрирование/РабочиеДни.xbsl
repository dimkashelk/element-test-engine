@ДоступноСКлиента
@НаСервере
@ВПодсистеме
метод ПолучитьДанные(): Соответствие<Строка, Булево>
    знч Данные = РабочиеДни.Получить()
    знч Результат: Соответствие<Строка, Булево>
    Результат.Вставить("Понедельник", Данные.Понедельник)
    Результат.Вставить("Вторник", Данные.Вторник)
    Результат.Вставить("Среда", Данные.Среда)
    Результат.Вставить("Четверг", Данные.Четверг)
    Результат.Вставить("Пятница", Данные.Пятница)
    Результат.Вставить("Суббота", Данные.Суббота)
    Результат.Вставить("Воскресенье", Данные.Воскресенье)
    возврат Результат
;
