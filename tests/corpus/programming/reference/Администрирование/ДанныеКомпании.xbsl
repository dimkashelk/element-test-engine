@ДоступноСКлиента
@НаСервере
@ВПодсистеме
метод ПолучитьДанные(): Соответствие<Строка, Строка>
    знч Данные = ДанныеКомпании.Получить()
    знч Результат: Соответствие<Строка, Строка> = {
        "Телефон": Данные.Телефон,
        "ЮрАдрес": Данные.ЮрАдрес
    }
    Результат.Вставить("ПолноеНаименование", Данные.ПолноеНаименование)
    Результат["СокращенноеНаименование"] = Данные.СокращенноеНаименование
    возврат Результат
;
