@Обработчик
метод ПослеСоздания()
    знч ДатаСегодня = Дата.Сейчас()
    
    ОбновитьТекущееВремя()
    
    знч Данные = ДанныеКомпании.ПолучитьДанные()
    Компоненты.НадписьМестоРаботы.Значение = СформироватьТекстОрганизации(Данные)
    
    знч ТекущийДеньНедели = ДатаСегодня.ДеньНедели().Представление()
    знч НастройкиДней = РабочиеДни.ПолучитьДанные()
    Компоненты.НадписьТипДня.Значение = ПолучитьТекстДня(ТекущийДеньНедели, НастройкиДней)
    
    ОбновитьПриветствие()
    
    Компоненты.ДатаНачала.Значение = ДатаСегодня
    
;


метод ОбновитьТекущееВремя()
    Компоненты.НадписьТекущееВремя.Значение = ПолучитьНадписьТекущееВремя("Сейчас", Время.Сейчас())
;


метод ОбновитьПриветствие()
    знч ВремяСейчас = Время.Сейчас()
    
    знч Время00 = Время{0:0}
    знч Время06 = Время{6:0}
    знч Время12 = Время{12:0}
    знч Время18 = Время{18:0}
    
    если Время00 <= ВремяСейчас и ВремяСейчас < Время06
        Приветствие = "Доброй ночи"
    иначе если Время06 <= ВремяСейчас и ВремяСейчас < Время12
        Приветствие = "Доброе утро"
    иначе если Время12 <= ВремяСейчас и ВремяСейчас < Время18
        Приветствие = "Добрый день"
    иначе
        Приветствие = "Добрый вечер"
    ;
;


метод ПолучитьНадписьТекущееВремя(Начало: Строка, ТекущееВремя: Время): Строка
    возврат "${Начало}: ${ТекущееВремя}"
;


@Локально
метод СформироватьТекстОрганизации(Данные: Соответствие<Строка, Строка>): Строка
    знч ПолноеНаименование = Данные.Получить("ПолноеНаименование")
    знч СокращенноеНаименование = Данные.Получить("СокращенноеНаименование")
    знч Телефон = Данные.Получить("Телефон")
    знч ЮрАдрес = Данные.Получить("ЮрАдрес")
    возврат "Вы работаете в ${ПолноеНаименование}; сокращённо: ${СокращенноеНаименование}; телефон: ${Телефон}; юридический адрес: ${ЮрАдрес}"
;


@Локально
метод ПолучитьТекстДня(ИмяДня: Строка, НастройкиДней: Соответствие<Строка, Булево>): Строка
    если НастройкиДней.Получить(ИмяДня)
        возврат "Сегодня: ${ИмяДня} — рабочий день"
    иначе
        возврат "Сегодня: ${ИмяДня} — выходной день"
    ;
;


метод КнопкаРассчитатьПриНажатии(Источник: Кнопка, Событие: СобытиеПриНажатии)
    знч ДатаНачало = Компоненты.ДатаНачала.Значение
    знч ДатаКонец = Компоненты.ДатаКонца.Значение

    если ДатаНачало > ДатаКонец
        Компоненты.НадписьРезультат.Значение = "Дата начала больше даты окончания периода"
    иначе
        знч Дни = РабочиеДни.ПолучитьДанные()
        знч Результат = РассчитатьДни(ДатаНачало, ДатаКонец, Дни)
        знч Календарных = Результат.Получить("Календарных")
        знч Рабочих = Результат.Получить("Рабочих")
        знч Нерабочих = Результат.Получить("Нерабочих")
        Компоненты.НадписьРезультат.Значение = "Календарных: ${Календарных}; рабочих: ${Рабочих}; нерабочих: ${Нерабочих}"
    ;
;


@Локально
метод РассчитатьДни(ДатаНачало: Дата, ДатаКонец: Дата, Дни: Соответствие<Строка, Булево>): Соответствие<Строка, Число>
    пер ТекущаяДата = ДатаНачало
    пер Календарных = 0
    пер Рабочих = 0
    пер Нерабочих = 0
    пока ТекущаяДата <= ДатаКонец
        Календарных += 1
        знч ИмяДня = ТекущаяДата.ДеньНедели().Представление()
        если Дни.Получить(ИмяДня)
            Рабочих += 1
        иначе
            Нерабочих += 1
        ;
        ТекущаяДата = ТекущаяДата.ДобавитьДни(1)
    ;
    знч Результат: Соответствие<Строка, Число> = {
        "Календарных": Календарных,
        "Рабочих": Рабочих,
        "Нерабочих": Нерабочих
    }
    возврат Результат
;

