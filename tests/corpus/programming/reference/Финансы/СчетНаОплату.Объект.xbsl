@Обработчик
метод ПриСозданииНаОсновании(Основание: Движок::Движок::Продажи::Заказ.Ссылка)
    пер СуммаИтог = 0
    знч ЗаказКлиента = Основание.ЗагрузитьОбъект()
    для Элемент из ЗаказКлиента.Товары
        СуммаИтог += Элемент.Сумма
    ;
    Сумма = СуммаИтог
    этот.Основание = Основание
    Контрагент = ЗаказКлиента.Клиент
;