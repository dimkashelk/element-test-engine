импорт Товары

@Обработчик
метод ПослеСоздания()
    если Объект.ЭтоНовый()
        ЗаголовокФормы = "Заказ (новый)"
    иначе
        ЗаголовокФормы = "Заказ (№${Объект.Номер})"
    ;
    ОбновитьПредставлениеАрхивирования()
;

метод ПредставлениеРедактированиеДанныхОбработчик(Команда: ОбычнаяКоманда)
    если РедактированиеДанных
        РедактированиеДанных = Ложь
        ПредставлениеРедактированиеДанных = "Разрешить редактирование реквизитов"
    иначе
        РедактированиеДанных = Истина
        ПредставлениеРедактированиеДанных = "Запретить редактирование реквизитов"
    ;
;

метод АрхивироватьОбработчик(Команда: ОбычнаяКоманда)
    если Объект.Архивный
        Объект.Архивный = Ложь
    иначе
        Объект.Архивный = Истина
    ;
    Записать()
    ОбновитьПредставлениеАрхивирования()
;

@Локально
метод ОбновитьПредставлениеАрхивирования()
    если Объект.Архивный
        ПредставлениеАрхивирования = "Вернуть из архива"
    иначе
        ПредставлениеАрхивирования = "Архивировать"
    ;
;

метод ИтогиОтмеченныхОбработчик(Команда: КомандаСПараметром<Массив<Заказ.Товары>>, Параметр: Массив<Заказ.Товары>)
    знч Итоги = РассчитатьИтоги(Параметр)
    знч КоличествоСтрок = Итоги.Получить("Строк")
    знч КоличествоТоваров = Итоги.Получить("Товаров")
    знч Сумма = Итоги.Получить("Сумма")
    Компоненты.НадписьИтогиОтмеченных.Значение = "Строк: ${КоличествоСтрок}; товаров: ${КоличествоТоваров}; сумма: ${Сумма}"
;

метод ОтгрузитьОбработчик(Команда: КомандаСПараметром<Массив<Заказ.Товары>>, Параметр: Массив<Заказ.Товары>)
    знч Итоги = РассчитатьИтоги(Параметр)
    знч НовыйДокумент = Отгрузка.СоздатьЧасть(Параметр)
    ОтгрузкаФормаОбъекта.Открыть(
        СозданныйНаЧасти = Истина,
        ТоварыТабличнаяЧасть = НовыйДокумент.Товары,
        КоличествоВыбранныхСтрок = Итоги.Получить("Строк"),
        КоличествоТоваров = Итоги.Получить("Товаров"),
        СуммаВыбранныхТоваров = Итоги.Получить("Сумма")
    )
;

@Локально
метод РассчитатьИтоги(Строки: Массив<Заказ.Товары>): Соответствие<Строка, Число>
    пер КоличествоСтрок = 0
    пер КоличествоТоваров = 0
    пер СуммаТоваров = 0
    для Элемент из Строки
        КоличествоСтрок += 1
        КоличествоТоваров += Элемент.Количество
        СуммаТоваров += Элемент.Сумма
    ;
    знч Итоги: Соответствие<Строка, Число> = {
        "Строк": КоличествоСтрок,
        "Товаров": КоличествоТоваров,
        "Сумма": СуммаТоваров
    }
    возврат Итоги
;
