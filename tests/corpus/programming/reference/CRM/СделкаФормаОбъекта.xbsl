@Обработчик
метод ПослеСоздания()
    если Объект.ЭтоНовый()
        ЗаголовокФормы = "Сделка (новая)"
    иначе
        ЗаголовокФормы = "Сделка (№${Объект.Номер})"
    ;
    ОбновитьПредставлениеАрхивирования()
;

метод ПредставлениеРедактированиеДанныхОбработчик(Команда: ОбычнаяКоманда)
    если РедактированиеДанных
        РедактированиеДанных = Ложь
        ПредставлениеРедактированиеДанных = "Разрешить редактирование реквизитов"
    иначе
        РедактированиеДанных = Истина
        ПредставлениеРедактированиеДанных = "Запретить редактирование реквизитов"
    ;
;

метод АрхивироватьОбработчик(Команда: ОбычнаяКоманда)
    если Объект.Архивный
        Объект.Архивный = Ложь
    иначе
        Объект.Архивный = Истина
    ;
    Записать()
    ОбновитьПредставлениеАрхивирования()
;

@Локально
метод ОбновитьПредставлениеАрхивирования()
    если Объект.Архивный
        ПредставлениеАрхивирования = "Вернуть из архива"
    иначе
        ПредставлениеАрхивирования = "Архивировать"
    ;
;

метод СуммаОтмеченногоСпросаОбработчик(Команда: КомандаСПараметром<Массив<Сделка.ПервичныйСпрос>>, Параметр: Массив<Сделка.ПервичныйСпрос>)
    пер Количество = 0
    пер Сумма = 0
    для Элемент из Параметр
        Количество += 1
        Сумма += Элемент.Сумма
    ;
    Компоненты.НадписьСуммаСпроса.Значение = "Отмечено строк: ${Количество}; сумма: ${Сумма}"
;

метод ПосчитатьУчастниковОбработчик(Команда: КомандаСПараметром<Массив<Сделка.Участники>>, Параметр: Массив<Сделка.Участники>)
    пер Количество = Параметр.Размер()
    Компоненты.НадписьКоличествоУчастников.Значение = "Отмечено участников: ${Количество}"
;
