метод Union(): Объект
    возврат Запрос{ВЫБРАТЬ Номер КАК Value ИЗ Учет::Строки ОБЪЕДИНИТЬ ВЫБРАТЬ Номер КАК Ignored ИЗ Other::Строки}.Выполнить()
;
метод All(): Объект
    возврат Запрос{ВЫБРАТЬ Номер КАК Value ИЗ Учет::Строки ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Номер КАК Ignored ИЗ Other::Строки}.Выполнить()
;
метод Mixed(): Объект
    возврат Запрос{ВЫБРАТЬ Номер КАК Value ИЗ Учет::Строки ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Номер ИЗ Other::Строки ОБЪЕДИНИТЬ РАЗЛИЧНЫЕ ВЫБРАТЬ Номер ИЗ Other::Строки}.Выполнить()
;
метод Sorted(): Объект
    возврат Запрос{ВЫБРАТЬ Номер КАК Value ИЗ Учет::Строки ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Номер ИЗ Other::Строки УПОРЯДОЧИТЬ ПО Value УБЫВ}.Выполнить()
;
метод Nested(): Объект
    возврат Запрос{ВЫБРАТЬ Q.Value * 2 КАК Total ИЗ (ВЫБРАТЬ Номер КАК Value ИЗ Учет::Строки ОБЪЕДИНИТЬ ВЫБРАТЬ Номер ИЗ Other::Строки) КАК Q ГДЕ Q.Value >= 2 УПОРЯДОЧИТЬ ПО Total}.Выполнить()
;
метод Deep(): Объект
    возврат Запрос{ВЫБРАТЬ Q.Value ИЗ (ВЫБРАТЬ R.Value ИЗ (ВЫБРАТЬ Значение КАК Value ИЗ Учет::Строки) КАК R ГДЕ R.Value > 1) КАК Q}.Выполнить()
;
метод NestedJoin(): Объект
    возврат Запрос{ВЫБРАТЬ Q.Номер, B.Значение КАК Value ИЗ (ВЫБРАТЬ Номер ИЗ Учет::Строки ОБЪЕДИНИТЬ ВЫБРАТЬ Номер ИЗ Other::Строки) КАК Q ЛЕВОЕ СОЕДИНЕНИЕ Other::Строки КАК B ПО Q.Номер == B.Номер}.Выполнить()
;
метод NestedNull(): Объект
    возврат Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(Q.Value) КАК Count, СУММА(Q.Value.ЗаменитьNull(10)) КАК Sum ИЗ (ВЫБРАТЬ B.Значение КАК Value ИЗ Учет::Строки КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Строки КАК B ПО A.Номер == B.Номер) КАК Q}.Выполнить()
;
метод NullUnion(): Объект
    возврат Запрос{ВЫБРАТЬ КОЛИЧЕСТВО(Q.Value) КАК Count ИЗ (ВЫБРАТЬ ВЫБОР КОГДА Номер == 1 ТОГДА NULL ИНАЧЕ Peer КОНЕЦ КАК Value ИЗ Учет::Строки ОБЪЕДИНИТЬ ВЫБРАТЬ Peer КАК Value ИЗ Учет::Строки ГДЕ Номер > 1) КАК Q}.Выполнить()
;
метод NullNumber(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 NULL КАК Value ИЗ Учет::Строки ОБЪЕДИНИТЬ ВЫБРАТЬ Значение КАК Value ИЗ Other::Строки}.Выполнить()
;
метод In(): Объект
    возврат Запрос{ВЫБРАТЬ Значение КАК Value ИЗ Учет::Строки ГДЕ Номер В (ВЫБРАТЬ Номер ИЗ Other::Строки)}.Выполнить()
;
метод NotIn(): Объект
    возврат Запрос{ВЫБРАТЬ Значение КАК Value ИЗ Учет::Строки ГДЕ Номер НЕ В (ВЫБРАТЬ Номер ИЗ Other::Строки)}.Выполнить()
;
метод EmptyIn(): Объект
    возврат Запрос{ВЫБРАТЬ Номер ИЗ Учет::Строки ГДЕ Номер НЕ В (ВЫБРАТЬ Номер ИЗ Other::Строки ГДЕ Номер < 0)}.Выполнить()
;
метод UnknownIn(): Объект
    возврат Запрос{ВЫБРАТЬ Номер ИЗ Учет::Строки ГДЕ Номер НЕ В (ВЫБРАТЬ NULL КАК Номер ИЗ Other::Строки)}.Выполнить()
;
метод Compound(): Объект
    возврат Запрос{ВЫБРАТЬ Номер ИЗ Учет::Строки; ВЫБРАТЬ Label ИЗ Other::Строки}.Выполнить()
;
метод Temp(): Объект
    возврат Запрос{ВЫБРАТЬ Номер КАК Value ПОМЕСТИТЬ T ИЗ Учет::Строки ОБЪЕДИНИТЬ ВЫБРАТЬ Номер ИЗ Other::Строки ИНДЕКСИРОВАТЬ ПО Value; ВЫБРАТЬ Value ИЗ T ГДЕ Value > 1}.Выполнить()
;
метод TempJoin(): Объект
    возврат Запрос{ВЫБРАТЬ Номер, Значение ПОМЕСТИТЬ T ИЗ Учет::Строки; СОЗДАТЬ ИНДЕКС Idx ДЛЯ T (Номер) ДОПОЛНИТЕЛЬНО ПО (Значение); ВЫБРАТЬ T.Номер, СУММА(T.Значение) КАК Sum ИЗ T ВНУТРЕННЕЕ СОЕДИНЕНИЕ Other::Строки КАК B ПО T.Номер == B.Номер СГРУППИРОВАТЬ ПО T.Номер}.Выполнить()
;
метод TempIn(): Объект
    возврат Запрос{ВЫБРАТЬ Номер ПОМЕСТИТЬ T ИЗ Other::Строки; ВЫБРАТЬ Значение КАК Value ИЗ Учет::Строки ГДЕ Номер В (ВЫБРАТЬ Номер ИЗ T)}.Выполнить()
;
метод TempNull(): Объект
    возврат Запрос{ВЫБРАТЬ B.Значение КАК Value ПОМЕСТИТЬ T ИЗ Учет::Строки КАК A ЛЕВОЕ СОЕДИНЕНИЕ Other::Строки КАК B ПО A.Номер == B.Номер; ВЫБРАТЬ КОЛИЧЕСТВО(Value) КАК Count, СУММА(Value.ЗаменитьNull(10)) КАК Sum ИЗ T}.Выполнить()
;
метод Create(): Объект
    возврат Запрос{СОЗДАТЬ ВРЕМЕННУЮ ТАБЛИЦУ T (Номер: Число, Label: Строка); СОЗДАТЬ ИНДЕКС Idx ДЛЯ T (Номер); ВЫБРАТЬ Номер, Label ИЗ T}.Выполнить()
;
метод Drop(): Объект
    возврат Запрос{ВЫБРАТЬ Номер ПОМЕСТИТЬ T ИЗ Учет::Строки; УНИЧТОЖИТЬ T}.Выполнить()
;
метод Recreate(): Объект
    возврат Запрос{ВЫБРАТЬ Номер ПОМЕСТИТЬ T ИЗ Учет::Строки; УНИЧТОЖИТЬ T; СОЗДАТЬ ВРЕМЕННУЮ ТАБЛИЦУ T (Label: Строка); ВЫБРАТЬ Label ИЗ T}.Выполнить()
;
метод Truncate(): Объект
    возврат Запрос{ВЫБРАТЬ Номер ПОМЕСТИТЬ T ИЗ Учет::Строки; ОБРЕЗАТЬ T; ВЫБРАТЬ Номер ИЗ T}.Выполнить()
;
метод Fill(): Объект
    возврат Запрос{ВЫБРАТЬ Q.Номер, СУММА(Q.Значение) КАК Sum ЗАПОЛНИТЬ Учет::Card ИЗ (ВЫБРАТЬ Номер, Значение ИЗ Учет::Строки ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Номер, Значение ИЗ Other::Строки) КАК Q СГРУППИРОВАТЬ ПО Q.Номер}.Выполнить()
;
метод Params(): Объект
    знч Calls = новый Массив<Число>()
    знч Q = Запрос{ВЫБРАТЬ Значение + %{Capture(Calls, 1)} КАК Value ПОМЕСТИТЬ T ИЗ Учет::Строки ГДЕ Номер == %{Capture(Calls, 2)}; ВЫБРАТЬ Value + %{Capture(Calls, 3)} КАК Value ИЗ T ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Значение + %{Capture(Calls, 4)} КАК Value ИЗ Other::Строки}
    возврат {"rows": Q.Выполнить(), "calls": Calls}
;
метод Shared(Bonus: Число): Объект
    возврат Запрос{ВЫБРАТЬ Номер + %Bonus КАК Value ИЗ Учет::Строки ГДЕ Номер == %Bonus ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Номер + %Bonus КАК Value ИЗ Other::Строки}.Выполнить()
;
метод Quoted(): Объект
    возврат Запрос{ВЫБРАТЬ "a; ОБЪЕДИНИТЬ (ВЫБРАТЬ" КАК Value ИЗ Other::Строки; // ; ОБЪЕДИНИТЬ
 ВЫБРАТЬ Номер ИЗ Other::Строки}.Выполнить()
;
метод Unsupported(): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Missing::Table}.Выполнить()
;
метод Capture(Calls: Массив<Число>, N: Число): Число
    Calls.Добавить(N)
    возврат N
;
метод CaptureState(Calls: Массив<Строка>, N: Число): Число
    Calls.Добавить("capture")
    возврат N
;
метод State(): Объект
    знч Calls = новый Массив<Строка>()
    знч Q = Запрос{ВЫБРАТЬ СУММА(Значение + %{CaptureState(Calls, 1)}) КАК Sum ПОМЕСТИТЬ T ИЗ Учет::Строки; ВЫБРАТЬ Sum ИЗ T}
    знч Old = Q.Выполнить()
    пер Seen: Объект = новый Массив<Объект>()
    попытка
        исп Транзакции.Начать()
        знч V = новый Учет::Строки.Объект(Ссылка = Учет::Строки.ПолучитьСсылку(новый Ууид("11111111-1111-4111-8111-111111111111")), Номер = 1, Значение = 20, Label = "a", Day = новый Дата(2024, 2, 28))
        V.Записать()
        Seen = Q.Выполнить()
        выбросить новый ИсключениеВалидации("rollback")
    поймать E: ИсключениеВалидации
        возврат {"old": Old, "seen": Seen, "after": Q.Выполнить(), "calls": Calls}
    ;
;
