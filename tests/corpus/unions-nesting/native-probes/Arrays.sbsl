метод Capture(Calls: Массив<Число>, N: Число): Число
    Calls.Добавить(N)
    возврат N
;
метод Pair(A: Число, B: Число): Число
    возврат A + B
;
метод Скрипт()
    знч Calls = новый Массив<Число>()
    знч Result = Pair(Capture(Calls, 1), Capture(Calls, 2))
    знч Values = [1, 2, 2]
    знч Empty = новый Массив<Число>()
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"calls": Calls, "sum": Result, "first": Values.ПервыйИлиНеопределено(), "empty": Empty.ПервыйИлиНеопределено(), "size": Values.Размер()}))
;
