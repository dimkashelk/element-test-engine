метод distinct(): Объект
    возврат Запрос{ВЫБРАТЬ РАЗЛИЧНЫЕ Label ИЗ Data::Item}.Выполнить()
;
метод union(): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ОБЪЕДИНИТЬ ВЫБРАТЬ Label ИЗ Other::Item}.Выполнить()
;
метод union_all(): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Label ИЗ Other::Item}.Выполнить()
;
метод nested(): Объект
    возврат Запрос{ВЫБРАТЬ Q.Label ИЗ (ВЫБРАТЬ Label ИЗ Data::Item) КАК Q}.Выполнить()
;
метод compound(): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item; ВЫБРАТЬ Label ИЗ Other::Item}.Выполнить()
;
