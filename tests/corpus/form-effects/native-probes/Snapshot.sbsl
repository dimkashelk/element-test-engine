структура СтрокаДанных
    пер Amount: Число
;
структура Запрос
    пер Lines: Массив<СтрокаДанных>
    пер Optional: Ууид?
;
метод Скрипт()
    знч Исходные = [новый СтрокаДанных(Amount = 1.25)]
    знч Переданные = новый Запрос(Lines = Исходные, Optional = Ууид{00000000-0000-4000-8000-000000000036})
    знч Снимок = СериализацияJson.ПрочитатьОбъект(СериализацияJson.ЗаписатьОбъект(Переданные))
    знч Контекст = СериализацияJson.ПрочитатьОбъект<Запрос>(СериализацияJson.ЗаписатьОбъект(Переданные), Переданные.ПолучитьТип())
    Контекст.Lines[0].Amount = 999
    Исходные[0].Amount = 33
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"snapshot": Снимок, "source": Исходные, "context": Контекст, "id": Ууид.Случайный()}))
;
