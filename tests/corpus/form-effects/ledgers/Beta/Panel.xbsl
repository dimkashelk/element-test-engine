импорт Alpha::Window как Destination
метод Apply(C: ОбычнаяКоманда)
    Объект.Archived = не Объект.Archived
    Записать()
    Decorate()
;
метод Decorate()
    Caption = Объект.Archived ? "on" : "off"
;
метод Show(Rows: Массив<Alpha::Ledger.Rows>)
    Destination.Открыть(Lines = Rows, Optional = Неопределено)
    если Rows.Размер() > 0
        Rows[0].Amount = 33
    ;
    Destination.Открыть(Lines = Rows)
;
метод Local()
    Записать()
;
