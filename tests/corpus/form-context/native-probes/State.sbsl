@Глобально
структура Label
    пер Значение: Строка
;
@Глобально
структура Components
    пер Caption: Label
;
@Глобально
структура Command
;
@Глобально
структура Record
    пер Номер: Строка
    пер Новый: Булево
    метод ЭтоНовый(): Булево
        возврат Новый
    ;
;
@Глобально
структура Form
    пер Объект: Record
    пер Компоненты: Components
    пер Enabled: Булево
    пер Title: Строка = "default"
    пер Rows: Массив<Число>
    метод Toggle(Enabled: Булево, C: Command)
        этот.Enabled = Enabled
        Компоненты.Caption.Значение = "${Rows.Размер()}; ${1.25}"
    ;
;
метод Скрипт()
    знч A = новый Form(Объект = новый Record(Номер = "42", Новый = Истина))
    знч B = новый Form()
    A.Rows.Добавить(1)
    A.Toggle(Истина, новый Command())
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"a": A, "b": B, "new": A.Объект.ЭтоНовый()}))
;
