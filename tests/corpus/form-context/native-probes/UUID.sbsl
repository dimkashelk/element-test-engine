@Глобально
структура Reference
    пер Id: Ууид
;
@Глобально
структура Entity
    пер Ref: Reference
    пер Rows: Массив<Число>
;
метод Скрипт()
    знч Id = новый Ууид("00000000-0000-0000-0000-000000000034")
    знч A = новый Entity(Ref = новый Reference(Id = Id))
    знч B = новый Entity(Ref = новый Reference(Id = Id))
    A.Rows.Добавить(2.5)
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"a": A, "b": B, "empty": новый Reference()}))
;
