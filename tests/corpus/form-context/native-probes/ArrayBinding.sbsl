@Глобально
структура Row
    пер Value: Число
;
@Глобально
структура Entity
    пер Rows: Массив<Row>
;
метод Change(Rows: Массив<Row>)
    Rows[0].Value = 999
;
метод Скрипт()
    знч A = новый Entity(Rows = [новый Row(Value = 2.5)])
    знч B = новый Entity(Rows = [новый Row(Value = 2.5)])
    Change(A.Rows)
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"a": A, "b": B}))
;
