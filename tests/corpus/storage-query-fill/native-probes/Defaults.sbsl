структура Проба
    пер Текст: Строка
    пер Число: Число
    пер Флаг: Булево
    пер День: Дата
    пер Ид: Ууид
    пер Пусто: Дата?
    пер Явно: Строка = "default"
    знч Фиксировано: Число = 7
    обз пер Нужно: Число
;
метод Скрипт()
    знч А = новый Проба(Нужно = 4)
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект(А))
    Консоль.Записать((1.005).Округлить(2))
    Консоль.Записать((-1.005).Округлить(2))
;
