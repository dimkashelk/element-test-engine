структура Ссылка
    пер Идентификатор: Ууид
;
структура Проба
    обз знч Name: Строка
    пер Amount: Число?
    пер Ref: Ссылка?
;
метод Скрипт()
    знч Ref = новый Ссылка(Идентификатор = новый Ууид("11111111-1111-4111-8111-111111111111"))
    знч А = новый Проба(Ref = Ref, Amount = 3, Name = "A")
    пер Maybe: Число? = 4
    знч Б = новый Проба(Name = "B", Amount = Maybe)
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект([А, Б]))
;
