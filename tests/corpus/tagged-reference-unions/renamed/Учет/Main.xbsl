метод Persist(Value: Учет::Узел.Ссылка|Архив::Узел.Ссылка|?, Детали: Массив<Запись.Детали>, Fail: Булево): Запись.Объект?
    знч O = новый Запись.Объект(Ссылка = Запись.ПолучитьСсылку("11111111-1111-4111-8111-111111111111"), Связь = Value, Детали = Детали, Scalar = "text")
    O.Записать(новый Запись.ПараметрыЗаписи(Fail = Fail))
    возврат O.Ссылка.ЗагрузитьОбъект()
;
метод Read(): Запись.Объект?
    возврат Запись.ПолучитьСсылку("11111111-1111-4111-8111-111111111111").ЗагрузитьОбъект()
;
метод Load(Value: Учет::Узел.Ссылка|Архив::Узел.Ссылка|?): Строка
    если Value это Учет::Узел.Ссылка
        знч O = (Value как Учет::Узел.Ссылка).ЗагрузитьОбъект()
        возврат O == Неопределено ? "missing-A" : (O как Учет::Узел.Объект).Label
    иначе если Value это Архив::Узел.Ссылка
        знч O = (Value как Архив::Узел.Ссылка).ЗагрузитьОбъект()
        возврат O == Неопределено ? "missing-B" : (O как Архив::Узел.Объект).Label
    ;
    возврат "NULL"
;
метод Equal(A: Учет::Узел.Ссылка|Архив::Узел.Ссылка|?, B: Учет::Узел.Ссылка|Архив::Узел.Ссылка|?): Булево
    возврат A == B
;
метод Query(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ Связь КАК Ref ЗАПОЛНИТЬ Result ИЗ Запись}.Выполнить()
;

метод LoadStored(): Строка
    знч O = Read()
    возврат O == Неопределено ? "missing" : Load((O как Запись.Объект).Связь)
;
метод Fresh(): Строка
    знч R: Учет::Узел.Ссылка = Учет::Узел.ПолучитьСсылку("22222222-2222-4222-8222-222222222222")
    знч O = R.ЗагрузитьОбъект() как Учет::Узел.Объект
    O.Label = "updated-A"
    O.Записать()
    возврат LoadStored()
;
метод DetachedReferences(): Булево
    знч O = Read() как Запись.Объект
    знч Again = Read() как Запись.Объект
    (O.Детали[0].Связь как Учет::Узел.Ссылка).Идентификатор = "33333333-3333-4333-8333-333333333333"
    O.Детали[0].Index = 900
    возврат O.Детали[3].Связь == O.Связь и Again.Детали[0].Связь == O.Связь и Again.Детали[0].Index == 0
;
метод Unavailable(): Строка
    знч R = новый Flow.НаборЗаписей()
    R.Фильтр.Установить()
    возврат "unavailable"
;
