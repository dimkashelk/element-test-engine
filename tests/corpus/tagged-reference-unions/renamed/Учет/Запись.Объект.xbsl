метод ПередЗаписью(До: Запись.Данные, Параметры: Запись.ПараметрыЗаписи)
    Previous = До.Связь это Учет::Узел.Ссылка ? "A" : (До.Связь это Архив::Узел.Ссылка ? "B" : "NULL")
    если не До.Детали.Пусто()
        До.Детали[0].Index = 777
    ;
    Detached = Детали.Пусто() или Детали[0].Index != 777
;
метод ПослеЗаписи(До: Запись.Данные, Параметры: Запись.ПараметрыЗаписи)
    знч R = новый Flow.НаборЗаписей()
    R.Фильтр.Установить(Регистратор = Ссылка)
    R.ДобавитьЗапись(Период = новый ДатаВремя("2026-10-11T12:00:00"), ВидЗаписи = ВидЗаписиРегистраНакопления.Приход, Key = "effect", Count = Связь это Учет::Узел.Ссылка ? 1 : 2)
    R.Записать()
    если Параметры.Fail
        выбросить новый ИсключениеНедопустимоеСостояние("reject-after")
    ;
;
