метод ПередЗаписью(До: Card.Данные, Параметры: Card.ПараметрыЗаписи)
    Previous = До.Choice это Data::Item.Ссылка ? "A" : (До.Choice это Other::Item.Ссылка ? "B" : "NULL")
    если не До.Rows.Пусто()
        До.Rows[0].Index = 777
    ;
    Detached = Rows.Пусто() или Rows[0].Index != 777
;
метод ПослеЗаписи(До: Card.Данные, Параметры: Card.ПараметрыЗаписи)
    знч R = новый Flow.НаборЗаписей()
    R.Фильтр.Установить(Регистратор = Ссылка)
    R.ДобавитьЗапись(Период = новый ДатаВремя("2026-10-11T12:00:00"), ВидЗаписи = ВидЗаписиРегистраНакопления.Приход, Key = "effect", Count = Choice это Data::Item.Ссылка ? 1 : 2)
    R.Записать()
    если Параметры.Fail
        выбросить новый ИсключениеНедопустимоеСостояние("reject-after")
    ;
;
