// Portable generated English test contract; production names are unchanged.
метод First(D: Дата): Объект
    возврат Запрос{ВЫБРАТЬ Key, Total ИЗ Data::Book.СрезПервых(%D)}.Выполнить()
;
метод Last(D: Дата): Объект
    возврат Запрос{ВЫБРАТЬ Key, Total ИЗ Data::Book.СрезПоследних(%D)}.Выполнить()
;
метод FirstAll(): Объект
    возврат Запрос{ВЫБРАТЬ Key, Total ИЗ Data::Book.СрезПервых()}.Выполнить()
;
метод Seconds(T: ДатаВремя): Объект
    возврат Запрос{ВЫБРАТЬ Key, Total ИЗ Data::Seconds.СрезПоследних(%T)}.Выполнить()
;
метод SecondsFirst(T: ДатаВремя): Объект
    возврат Запрос{ВЫБРАТЬ Key, Total ИЗ Data::Seconds.СрезПервых(%T)}.Выполнить()
;
метод Info(): Объект
    возврат Запрос{ВЫБРАТЬ Key, Total ИЗ Data::Book}.Выполнить()
;
метод Plain(): Объект
    возврат Запрос{ВЫБРАТЬ Key, Total ИЗ Data::Plain}.Выполнить()
;
метод Balance(T: ДатаВремя): Объект
    возврат Запрос{ВЫБРАТЬ Key, TotalОстаток, TotalОстатокПоложительный, TotalОстатокОтрицательный ИЗ Data::Ledger.Остатки(%T)}.Выполнить()
;
метод BalanceAll(): Объект
    возврат Запрос{ВЫБРАТЬ Key, TotalОстаток ИЗ Data::Ledger.Остатки}.Выполнить()
;
метод Turnover(S: ДатаВремя, E: ДатаВремя): Объект
    возврат Запрос{ВЫБРАТЬ Key, TotalОборот, TotalПриход, TotalРасход ИЗ Data::Ledger.Обороты(%S, %E)}.Выполнить()
;
метод TurnoverAll(): Объект
    возврат Запрос{ВЫБРАТЬ Key, TotalОборот ИЗ Data::Ledger.Обороты}.Выполнить()
;
метод Combined(S: ДатаВремя, E: ДатаВремя): Объект
    возврат Запрос{ВЫБРАТЬ Key, TotalНачальныйОстаток, TotalКонечныйОстаток, TotalОборот, TotalПриход, TotalРасход ИЗ Data::Ledger.ОстаткиИОбороты(%S, %E)}.Выполнить()
;
метод Sales(S: ДатаВремя, E: ДатаВремя): Объект
    возврат Запрос{ВЫБРАТЬ Key, TotalОборот ИЗ Data::Sales.Обороты(%S, %E)}.Выполнить()
;
метод Rows(R: Data::Item.Ссылка): Объект
    возврат Запрос{ВЫБРАТЬ Индекс, НомерСтроки, Value ИЗ Data::Item.Rows ГДЕ Владелец == %R УПОРЯДОЧИТЬ ПО НомерСтроки}.Выполнить()
;
метод Phones(R: Data::Item.Ссылка): Объект
    возврат Запрос{ВЫБРАТЬ Индекс, Элемент ИЗ Data::Item.Phones ГДЕ Владелец == %R УПОРЯДОЧИТЬ ПО Индекс}.Выполнить()
;
метод Join(T: ДатаВремя): Объект
    возврат Запрос{ВЫБРАТЬ A.Key, B.TotalОстаток.ЗаменитьNull(0) КАК Value ИЗ Data::Item КАК A ЛЕВОЕ СОЕДИНЕНИЕ Data::Ledger.Остатки(%T) КАК B ПО A.Key == B.Key}.Выполнить()
;
метод Nested(S: ДатаВремя, E: ДатаВремя): Объект
    возврат Запрос{ВЫБРАТЬ СУММА(Q.TotalОборот) КАК Value ИЗ (ВЫБРАТЬ TotalОборот ИЗ Data::Ledger.Обороты(%S, %E)) КАК Q}.Выполнить()
;
метод Union(D: Дата): Объект
    возврат Запрос{ВЫБРАТЬ Key КАК Value ИЗ Data::Book.СрезПервых(%D) ОБЪЕДИНИТЬ ВЫБРАТЬ Key ИЗ Data::Ledger.Остатки}.Выполнить()
;
метод PostFilter(D: Дата, N: Число): Объект
    возврат Запрос{ВЫБРАТЬ Key ИЗ Data::Book.СрезПервых(%D) ГДЕ Total == %N}.Выполнить()
;
метод Users(B: Булево): Объект
    возврат Запрос{ВЫБРАТЬ Представление ИЗ Пользователи ГДЕ Администратор == %B}.Выполнить()
;
метод Constants(): Объект
    возврат Запрос{ВЫБРАТЬ Total ИЗ Data::Options}.Выполнить()
;
метод Saved(): Объект
    возврат Запрос{ВЫБРАТЬ Key, TotalОстаток ИЗ Data::Totals}.Выполнить()
;
метод Unsupported(): Объект
    возврат Запрос{ВЫБРАТЬ Key ИЗ Data::Ledger.Изменения}.Выполнить()
;
метод State(): Объект
    знч Query = Запрос{ВЫБРАТЬ Key, TotalОстаток ИЗ Data::Ledger.Остатки}
    знч Old = Query.Выполнить()
    пер During: Объект = новый Массив<Объект>()
    попытка
        исп Транзакции.Начать()
        знч Records = новый Data::Ledger.НаборЗаписей()
        Records.Фильтр.Установить(новый Data::Act.Ссылка(Идентификатор = новый Ууид("33333333-1234-4234-8234-123456789abc")))
        Records.ДобавитьЗапись(Период = новый ДатаВремя("2026-10-03T00:00:00"), ВидЗаписи = ВидЗаписиРегистраНакопления.Приход, Key = "a", Total = 5)
        Records.Записать()
        During = Query.Выполнить()
        выбросить новый ИсключениеВалидации("rollback")
    поймать Failure: ИсключениеВалидации
        возврат {"old": Old, "during": During, "after": Query.Выполнить()}
    ;
;
