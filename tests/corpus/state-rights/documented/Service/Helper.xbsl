импорт Data::Card как Shape
@Глобально
метод Identity(Value: Shape): Shape
    возврат Value
;
@Глобально
метод Date(Calls: Массив<Строка>, D: Дата): Дата
    Calls.Добавить("date")
    возврат D
;
@Глобально
метод Label(Calls: Массив<Строка>, L: Строка): Строка
    Calls.Добавить("label")
    возврат L
;
