метод ordinary(): Объект
    возврат Запрос{ВЫБРАТЬ X.Label КАК Name ИЗ Data::Item КАК X}.Выполнить().ВМассив()
;
метод parameters(Name: Строка): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ Label == %Name}.Выполнить().ВМассив()
;
метод captured_expression(Name: Строка): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ Label == %{{"k": Name}["k"] как Строка}}.Выполнить().ВМассив()
;
метод order_limit(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 2 Label ИЗ Data::Item УПОРЯДОЧИТЬ ПО Total УБЫВ}.Выполнить().ВМассив()
;
метод in(Values: Массив<Число>): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ Total В (%Values)}.Выполнить().ВМассив()
;
метод between(Low: Число, High: Число): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ Total МЕЖДУ %Low И %High}.Выполнить().ВМассив()
;
метод like(Pattern: Строка): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ Label ПОДОБНО %Pattern}.Выполнить().ВМассив()
;
