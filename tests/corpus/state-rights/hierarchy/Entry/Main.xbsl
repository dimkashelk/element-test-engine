метод Between(Low: Число, High: Число): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ Total МЕЖДУ %Low И %High}.Выполнить().ВМассив()
;
метод Like(Pattern: Строка): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ Label ПОДОБНО %Pattern}.Выполнить().ВМассив()
;
метод Distinct(): Объект
    возврат Запрос{ВЫБРАТЬ X.Label, Y.Label КАК Other ИЗ Data::Item КАК X ЛЕВОЕ СОЕДИНЕНИЕ Other::Item КАК Y ПО X.Label == Y.Label ГДЕ Y.Label НЕ ОТЛИЧАЕТСЯ ОТ NULL}.Выполнить().ВМассив()
;
метод Exists(): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ СУЩЕСТВУЕТ (ВЫБРАТЬ Label ИЗ Other::Item ГДЕ Total МЕЖДУ 1 И 4)}.Выполнить().ВМассив()
;
метод NotExists(): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ НЕ СУЩЕСТВУЕТ (ВЫБРАТЬ Label ИЗ Other::Item ГДЕ Total == 999)}.Выполнить().ВМассив()
;
метод Combined(): Объект
    возврат Запрос{ВЫБРАТЬ Label, СУММА(Total) КАК Amount ИЗ (ВЫБРАТЬ Label, Total ИЗ Data::Item ГДЕ Total МЕЖДУ 1 И 3 ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Label, Total ИЗ Data::Item ГДЕ Label ПОДОБНО "a") КАК X СГРУППИРОВАТЬ ПО Label ИМЕЮЩИЕ СУММА(Total) МЕЖДУ 2 И 8 УПОРЯДОЧИТЬ ПО Label}.Выполнить().ВМассив()
;
метод Mutate(): Объект
    возврат Запрос{ВЫБРАТЬ Label, Total ПОМЕСТИТЬ T ИЗ Data::Item; ВСТАВИТЬ В T (Label, Total) ЗНАЧЕНИЯ ("C", 4); ИЗМЕНИТЬ T УСТАНОВИТЬ Total = Total + 10, Label = Label + "!" ГДЕ Total МЕЖДУ 3 И 4; УДАЛИТЬ ИЗ T ГДЕ Label ПОДОБНО "c%"; ВЫБРАТЬ Label, Total ИЗ T УПОРЯДОЧИТЬ ПО Label}.Выполнить().ВМассив()
;
метод InsertSelect(): Объект
    возврат Запрос{ВЫБРАТЬ Label, Total ПОМЕСТИТЬ T ИЗ Data::Item; ВСТАВИТЬ В T (Total, Label) ВЫБРАТЬ Total + 10 КАК Changed, Label КАК Name ИЗ Data::Item}.Выполнить().ВМассив()
;
метод UpdateCount(): Объект
    возврат Запрос{ВЫБРАТЬ Label, Total ПОМЕСТИТЬ T ИЗ Data::Item; ИЗМЕНИТЬ T УСТАНОВИТЬ Total = Total + 1 ГДЕ Total МЕЖДУ 1 И 3}.Выполнить().ВМассив()
;
метод DeleteCount(): Объект
    возврат Запрос{ВЫБРАТЬ Label, Total ПОМЕСТИТЬ T ИЗ Data::Item; УДАЛИТЬ ИЗ T ГДЕ Total == 3}.Выполнить().ВМассив()
;
метод NullInsert(): Объект
    возврат Запрос{СОЗДАТЬ ВРЕМЕННУЮ ТАБЛИЦУ T (Name: Строка, Note: Строка?); ВСТАВИТЬ В T (Name) ЗНАЧЕНИЯ ("a"); ВЫБРАТЬ Name, Note ИЗ T}.Выполнить().ВМассив()
;
метод Repeat(): Объект
    возврат Запрос{ВЫБРАТЬ Label ПОМЕСТИТЬ T ИЗ Data::Item; УДАЛИТЬ ИЗ T; ВЫБРАТЬ Label ИЗ T}.Выполнить().ВМассив()
;
метод Access(): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item}.Выполнить().ВМассив()
;
метод UnsupportedHierarchy(Parent: Data::Item.Ссылка): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ Ссылка В ИЕРАРХИИ Data::Item.Unknown (%Parent)}.Выполнить().ВМассив()
;
метод Hierarchy(Parent: Data::Item.Ссылка): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Item ГДЕ Ссылка В ИЕРАРХИИ (%Parent)}.Выполнить().ВМассив()
;
метод Correlated(): Объект
    возврат Запрос{ВЫБРАТЬ X.Label ИЗ Data::Item КАК X ГДЕ СУЩЕСТВУЕТ (ВЫБРАТЬ Y.Label ИЗ Other::Item КАК Y ГДЕ Y.Label == X.Label)}.Выполнить().ВМассив()
;
метод PlatformDml(): Объект
    возврат Запрос{УДАЛИТЬ ИЗ Data::Item}.Выполнить().ВМассив()
;
метод State(): Объект
    знч Q = новый ПроизвольныйЗапрос("ВЫБРАТЬ Label, Total ИЗ Data::Item ГДЕ Label == &Name")
    Q.УстановитьПараметр("Name", "A")
    исп First = Q.Выполнить()
    знч Old = First.ВМассив()
    попытка
        исп Транзакции.Начать()
        знч O: Data::Item.Объект = Data::Item.ПолучитьСсылку(новый Ууид("11111111-1111-4111-8111-111111111111")).ЗагрузитьОбъект()
        O.Total = 8
        O.Записать()
        исп During = Q.Выполнить()
        знч Inside = During.ВМассив()
        выбросить новый ИсключениеНедопустимоеСостояние(СериализацияJson.ЗаписатьОбъект(Inside))
    поймать E: Исключение
        исп After = Q.Выполнить()
        знч InsideResult: Объект? = СериализацияJson.ПрочитатьОбъект(E.Описание)
        возврат {"old": Old, "during": InsideResult, "after": After.ВМассив()}
    ;
;
