метод Between(Low: Число, High: Число): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}) ГДЕ Total МЕЖДУ %Low И %High}.Выполнить().ВМассив()
;
метод Like(Pattern: Строка): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}) ГДЕ Label ПОДОБНО %Pattern}.Выполнить().ВМассив()
;
метод Distinct(): Объект
    возврат Запрос{ВЫБРАТЬ X.Label, Y.Label КАК Other ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}) КАК X ЛЕВОЕ СОЕДИНЕНИЕ Other::Item КАК Y ПО X.Label == Y.Label ГДЕ Y.Label НЕ ОТЛИЧАЕТСЯ ОТ NULL}.Выполнить().ВМассив()
;
метод Exists(): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}) ГДЕ СУЩЕСТВУЕТ (ВЫБРАТЬ Label ИЗ Other::Item ГДЕ Total МЕЖДУ 1 И 4)}.Выполнить().ВМассив()
;
метод NotExists(): Объект
    возврат Запрос{ВЫБРАТЬ Label ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}) ГДЕ НЕ СУЩЕСТВУЕТ (ВЫБРАТЬ Label ИЗ Other::Item ГДЕ Total == 999)}.Выполнить().ВМассив()
;
метод Combined(): Объект
    возврат Запрос{ВЫБРАТЬ Label, СУММА(Total) КАК Amount ИЗ (ВЫБРАТЬ Label, Total ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}) ГДЕ Total МЕЖДУ 1 И 3 ОБЪЕДИНИТЬ ВСЕ ВЫБРАТЬ Label, Total ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}) ГДЕ Label ПОДОБНО "a") КАК X СГРУППИРОВАТЬ ПО Label ИМЕЮЩИЕ СУММА(Total) МЕЖДУ 2 И 8 УПОРЯДОЧИТЬ ПО Label}.Выполнить().ВМассив()
;
метод Mutate(): Объект
    возврат Запрос{ВЫБРАТЬ Label, Total ПОМЕСТИТЬ T ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}); ВСТАВИТЬ В T (Label, Total) ЗНАЧЕНИЯ ("C", 4); ИЗМЕНИТЬ T УСТАНОВИТЬ Total = Total + 10, Label = Label + "!" ГДЕ Total МЕЖДУ 3 И 4; УДАЛИТЬ ИЗ T ГДЕ Label ПОДОБНО "c%"; ВЫБРАТЬ Label, Total ИЗ T УПОРЯДОЧИТЬ ПО Label}.Выполнить().ВМассив()
;
метод InsertSelect(): Объект
    возврат Запрос{ВЫБРАТЬ Label, Total ПОМЕСТИТЬ T ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}); ВСТАВИТЬ В T (Total, Label) ВЫБРАТЬ Total + 10 КАК Changed, Label КАК Name ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")})}.Выполнить().ВМассив()
;
метод UpdateCount(): Объект
    возврат Запрос{ВЫБРАТЬ Label, Total ПОМЕСТИТЬ T ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}); ИЗМЕНИТЬ T УСТАНОВИТЬ Total = Total + 1 ГДЕ Total МЕЖДУ 1 И 3}.Выполнить().ВМассив()
;
метод DeleteCount(): Объект
    возврат Запрос{ВЫБРАТЬ Label, Total ПОМЕСТИТЬ T ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}); УДАЛИТЬ ИЗ T ГДЕ Total == 3}.Выполнить().ВМассив()
;
метод NullInsert(): Объект
    возврат Запрос{СОЗДАТЬ ВРЕМЕННУЮ ТАБЛИЦУ T (Name: Строка, Note: Строка?); ВСТАВИТЬ В T (Name) ЗНАЧЕНИЯ ("a"); ВЫБРАТЬ Name, Note ИЗ T}.Выполнить().ВМассив()
;
метод Repeat(): Объект
    возврат Запрос{ВЫБРАТЬ Label ПОМЕСТИТЬ T ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}); УДАЛИТЬ ИЗ T; ВЫБРАТЬ Label ИЗ T}.Выполнить().ВМассив()
;
метод Correlated(): Объект
    возврат Запрос{ВЫБРАТЬ X.Label ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")}) КАК X ГДЕ СУЩЕСТВУЕТ (ВЫБРАТЬ Y.Label ИЗ Other::Item КАК Y ГДЕ Y.Label == X.Label)}.Выполнить().ВМассив()
;
метод PlatformDml(): Объект
    возврат Запрос{УДАЛИТЬ ИЗ Data::Book.СрезПоследних(%{новый Дата("2026-09-30")})}.Выполнить().ВМассив()
;
