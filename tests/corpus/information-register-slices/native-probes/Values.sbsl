структура Ref
    пер ID: Ууид
;
метод Скрипт()
    знч A = новый Дата(2026, 9, 29)
    знч B = новый Дата(2026, 9, 30)
    пер N: Ref? = Неопределено
    знч R = новый Ref(ID = новый Ууид("12345678-1234-4234-8234-123456789abc"))
    пер Some: Ref? = новый Ref(ID = R.ID)
    знч Today = Дата.Сейчас(новый ЧасовойПояс("UTC"))
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"less": A < B, "inclusive": B <= B, "greater": B > A, "nullFilled": N == R, "filled": Some == R, "null": N == Неопределено, "todayUTC": Today, "maximum": новый Дата(9999, 12, 31) > Today}))
;
