импорт Data::Prices как Book
импорт Data::Item как Entity
импорт Data::Partner как Vendor
импорт Service::Values как Helper
метод All(D: Дата): Объект
    возврат Запрос{ВЫБРАТЬ Product, Vendor, Zone, Период, Price, Factor, Link, Note ИЗ Book.СрезПоследних(%D) УПОРЯДОЧИТЬ ПО Период, Price}.Выполнить()
;
метод Current(): Объект
    возврат Запрос{ВЫБРАТЬ Период, Price ИЗ Book.СрезПоследних() УПОРЯДОЧИТЬ ПО Период, Price}.Выполнить()
;
метод DefaultDate(): Объект
    возврат Запрос{ВЫБРАТЬ Период, Price ИЗ Book.СрезПоследних(%{Неопределено}) УПОРЯДОЧИТЬ ПО Период, Price}.Выполнить()
;
метод Find(P: Entity.Ссылка, D: Дата): Число?
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 X.Price КАК Value ИЗ Book.СрезПоследних(%D) КАК X ГДЕ Product == %P УПОРЯДОЧИТЬ ПО X.Период УБЫВ, X.Price УБЫВ}.Выполнить().ЕдинственныйИлиНеопределено()?.Value
;
метод Resource(D: Дата, N: Число): Объект
    возврат Запрос{ВЫБРАТЬ Price ИЗ Book.СрезПоследних(%D) ГДЕ Price == %N УПОРЯДОЧИТЬ ПО Период}.Выполнить()
;
метод Reuse(P: Entity.Ссылка, D: Дата): Объект
    знч Calls = новый Массив<Строка>()
    знч Q = Запрос{ВЫБРАТЬ Product, Link, Price ИЗ Book.СрезПоследних(%{Helper.Boundary(Calls, D)}) ГДЕ Product == %{Helper.Product(Calls, P)} УПОРЯДОЧИТЬ ПО Период УБЫВ, Price УБЫВ}
    знч Old = Q.Выполнить()
    знч R = новый Book.НаборЗаписей()
    R.Фильтр.Установить(Product = P, Vendor = Неопределено, Zone = "EU")
    R.ДобавитьЗапись(Период = D, Product = P, Vendor = Неопределено, Zone = "EU", Price = 17, Factor = 9, Link = Неопределено, Note = "new")
    R.Записать()
    P.Идентификатор = новый Ууид("33333333-1234-4234-8234-123456789abc")
    знч New = Q.Выполнить()
    (Old[0].Product как Entity.Ссылка).Идентификатор = новый Ууид("abcdef12-1234-4234-8234-123456789abc")
    возврат {"old": Old, "new": New, "again": Q.Выполнить(), "calls": Calls}
;
метод Transaction(P: Entity.Ссылка, D: Дата): Объект
    пер Seen: Объект? = Неопределено
    попытка
        исп Транзакции.Начать()
        знч R = новый Book.НаборЗаписей()
        R.Фильтр.Установить(Product = P, Vendor = Неопределено, Zone = "EU")
        R.ДобавитьЗапись(Период = D, Product = P, Vendor = Неопределено, Zone = "EU", Price = 77, Factor = 1, Link = Неопределено, Note = "rollback")
        R.Записать()
        Seen = Find(P, D)
        выбросить новый ИсключениеВалидации("rollback")
    поймать E: ИсключениеВалидации
        возврат {"seen": Seen, "after": Find(P, D)}
    ;
;
метод Swallow(): Строка
    попытка
        Current()
    поймать E: Исключение
        возврат "caught"
    ;
    возврат "ok"
;
метод Nullable(P: Entity.Ссылка?, D: Дата): Объект
    возврат Запрос{ВЫБРАТЬ Price ИЗ Book.СрезПоследних(%D) ГДЕ Product == %P}.Выполнить()
;
метод Unsupported(): Объект
    возврат Запрос{ВЫБРАТЬ Price ИЗ Book.СрезПервых()}.Выполнить()
;

метод ByPeriod(D: Дата): Объект
    возврат Запрос{ВЫБРАТЬ Price ИЗ Book.СрезПоследних(%D) ГДЕ Период == %D УПОРЯДОЧИТЬ ПО Price}.Выполнить()
;
