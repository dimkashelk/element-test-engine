структура Ref
    пер ID: Ууид
;
структура Row
    знч Value: Число
;
метод Скрипт()
    знч ID = новый Ууид("12345678-1234-4234-8234-123456789abc")
    знч Empty = новый Массив<Row>()
    пер Multiple = ""
    попытка
        [новый Row(Value = 1), новый Row(Value = 2)].ЕдинственныйИлиНеопределено()
    поймать E: ИсключениеНедопустимоеСостояние
        Multiple = "multiple"
    ;
    пер N: Строка? = Неопределено
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"empty": Empty.ЕдинственныйИлиНеопределено(), "isEmpty": Empty.Пусто(), "single": [новый Row(Value = 9)].ЕдинственныйИлиНеопределено(), "multiple": Multiple, "nullEqual": N == Неопределено, "uuidEqual": ID == новый Ууид(ID.ВСтроку()), "refEqual": новый Ref(ID = ID) == новый Ref(ID = ID), "sort": "a" < "b"}))
;
