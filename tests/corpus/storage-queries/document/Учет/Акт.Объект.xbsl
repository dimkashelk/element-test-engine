метод ПослеЗаписи(До: Акт.Данные, Параметры: Акт.ПараметрыЗаписи)
    знч R = Запрос{ВЫБРАТЬ P.Сумма ИЗ Акт КАК P ГДЕ P.Тема = %{Тема}}.Выполнить().ЕдинственныйИлиНеопределено()
    если R == Неопределено или R.Сумма != Сумма
        выбросить новый ИсключениеНедопустимоеСостояние("handler cannot see write")
    ;
;
