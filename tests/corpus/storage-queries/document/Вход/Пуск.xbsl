импорт Учет::Акт как Источник
импорт Сервис::Параметры как Помощник
метод Искать(Тема: Строка): Источник.Ссылка?
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 P.Ссылка ИЗ Источник КАК P ГДЕ P.Тема == %Тема}.Выполнить().ЕдинственныйИлиНеопределено()?.Ссылка
;
метод Поля(Тема: Строка, Сумма: Число): Объект
    возврат Запрос{ВЫБРАТЬ P.Тема КАК Name, P.Сумма КАК Total, P.Заметка КАК Optional, P.Основание КАК Link ИЗ Источник КАК P ГДЕ P.Тема = %{Помощник.A(Тема)} И P.Сумма = %Сумма}.Выполнить()
;
метод Возрастание(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 2 P.Тема КАК Name, P.Сумма КАК Total ИЗ Источник КАК P УПОРЯДОЧИТЬ ПО Total ВОЗР, Name УБЫВ}.Выполнить()
;
метод Убывание(): Объект
    возврат Запрос{ВЫБРАТЬ ПЕРВЫЕ 1 P.Тема КАК Name ИЗ Источник КАК P УПОРЯДОЧИТЬ ПО P.Сумма УБЫВ}.Выполнить()
;
метод ПоСсылке(Ref: Источник.Ссылка): Число
    возврат Запрос{ВЫБРАТЬ Сумма ИЗ Источник ГДЕ Ссылка = %Ref}.Выполнить().ЕдинственныйИлиНеопределено()?.Сумма ?? -1
;
метод Single(): Объект?
    возврат Запрос{ВЫБРАТЬ Тема ИЗ Источник}.Выполнить().ЕдинственныйИлиНеопределено()
;
метод ЗаписатьАкт(ID: Ууид, Тема: Строка, Сумма: Число): Источник.Ссылка
    знч O = новый Источник.Объект(Ид = ID, Тема = Тема, Сумма = Сумма, Открыт = Истина)
    O.Записать()
    возврат O.Ссылка
;
метод Фиксация(ID: Ууид): Источник.Ссылка?
    исп Транзакции.Начать()
    ЗаписатьАкт(ID, "commit", 7)
    возврат Искать("commit")
;
метод Откат(ID: Ууид): Строка
    попытка
        исп Транзакции.Начать()
        ЗаписатьАкт(ID, "rollback", 9)
        если Искать("rollback") == Неопределено
            возврат "stale"
        ;
        выбросить новый ИсключениеНедопустимоеСостояние("rollback")
    поймать E: ИсключениеНедопустимоеСостояние
        возврат Искать("rollback") == Неопределено ? "gone" : "leaked"
    ;
;
метод Повтор(ID: Ууид): Объект
    пер Тема = "new"
    знч Q = Запрос{ВЫБРАТЬ Тема ИЗ Источник ГДЕ Тема = %Тема И Тема = %Тема}
    Тема = "other"
    знч Before = Q.Выполнить()
    ЗаписатьАкт(ID, "new", 8)
    знч After = Q.Выполнить()
    возврат {"before": Before, "after": After, "again": Q.Выполнить(), "empty": Before.Пусто()}
;
метод Unavailable(): Объект
    возврат Запрос{ВЫБРАТЬ P.Тема ИЗ Источник КАК P СОЕДИНЕНИЕ Источник КАК B ПО P.Тема = B.Тема}.Выполнить()
;
метод Параметр(Тема: Строка): Объект
    знч P = Помощник.A(Тема)
    возврат Запрос{ВЫБРАТЬ Тема ИЗ Источник ГДЕ Тема = %P И Тема = %P}.Выполнить()
;
метод Выражения(Тема: Строка): Объект
    возврат Запрос{ВЫБРАТЬ Тема ИЗ Источник ГДЕ Тема = %{Помощник.A(Тема)} И Тема = %{Помощник.A(Тема)}}.Выполнить()
;
метод Снимок(): Объект
    знч Q = Запрос{ВЫБРАТЬ Ссылка ИЗ Источник}
    знч Old = Q.Выполнить()
    Old[0].Ссылка.Идентификатор = новый Ууид("abcdef12-1234-4234-8234-123456789abc")
    возврат Q.Выполнить()
;
метод Loop(): Массив<Строка>
    знч R = новый Массив<Строка>()
    для С из Запрос{ВЫБРАТЬ Тема ИЗ Источник УПОРЯДОЧИТЬ ПО Сумма}.Выполнить()
        R.Добавить(С.Тема)
    ;
    возврат R
;
