метод ПослеЗаписи(До: Product.Данные, Параметры: Product.ПараметрыЗаписи)
    знч R = Запрос{ВЫБРАТЬ P.Amount ИЗ Product КАК P ГДЕ P.Label = %{Label}}.Выполнить().ЕдинственныйИлиНеопределено()
    если R == Неопределено или R.Amount != Amount
        выбросить новый ИсключениеНедопустимоеСостояние("handler cannot see write")
    ;
;
