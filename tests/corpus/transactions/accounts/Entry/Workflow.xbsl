импорт Service::Worker как Peer
метод Apply(ID: Ууид, Text: Строка, N: Число, Mode: Число): Data::Account.Ссылка
    Peer.Validate(Text)
    исп Транзакции.Начать()
    знч Ref = Peer.First(ID, Text, N)
    если Mode == 1
        возврат Ref
    ;
    Peer.Second(ID, Text, N)
    если Mode == 2
        Peer.Crash()
    ;
    если Mode == 3
        попытка
            Peer.Crash()
        поймать E: ИсключениеНедопустимоеСостояние
            выбросить новый ИсключениеНедопустимоеСостояние("wrong catch")
        поймать E: ИсключениеВалидации
            возврат Ref
        ;
    ;
    возврат Ref
;
метод Branch(ID: Ууид): Число
    если Истина
        исп Транзакции.Начать()
        Peer.First(ID, "branch", 5)
    ;
    Peer.Crash()
    возврат 0
;
метод Rethrow(): Число
    попытка
        Peer.Crash()
    поймать E: ИсключениеВалидации
        выбросить E
    ;
    возврат 0
;
метод Swallow(ID: Ууид): Строка
    попытка
        Apply(ID, "valid", 2.5, 0)
    поймать E: Исключение
        возврат "swallowed"
    ;
    возврат "normal"
;
метод General(): Строка
    попытка
        Peer.Crash()
    поймать E: Исключение
        возврат E.Описание
    ;
    возврат "missing"
;
метод TypeOps(): Булево
    пер Saved: ИсключениеВалидации|ИсключениеНедопустимоеСостояние = новый ИсключениеВалидации("typed")
    попытка
        выбросить Saved
    поймать E: Исключение
        возврат E это ИсключениеВалидации и (E как ИсключениеВалидации).Описание == "typed" и не (E это ИсключениеНедопустимоеСостояние)
    ;
;
метод TryResource(ID: Ууид): Строка
    попытка
        исп Транзакции.Начать()
        Peer.First(ID, "try", 5)
        Peer.Crash()
    поймать E: ИсключениеВалидации
        возврат "caught"
    ;
    возврат "normal"
;
метод CatchResource(ID: Ууид): Строка
    попытка
        Peer.Crash()
    поймать E: ИсключениеВалидации
        исп Транзакции.Начать()
        Peer.First(ID, "catch", 5)
        возврат "caught"
    ;
    возврат "normal"
;
метод Lock(Ref: Data::Account.Ссылка): Data::Account.Объект?
    возврат Ref.ЗагрузитьОбъект(Заблокировать = Истина)
;
метод Locked(Ref: Data::Account.Ссылка): Data::Account.Объект?
    исп Транзакции.Начать()
    возврат Lock(Ref)
;
метод State(): Булево
    возврат Транзакции.ЕстьАктивная()
;
метод ScopeState(): Булево
    исп Транзакции.Начать()
    возврат State()
;
метод Loop(ID: Ууид): Число
    для I из [1, 2, 3]
        исп Транзакции.Начать()
        Peer.First(ID, "loop", I)
        если I == 1
            продолжить
        ;
        прервать
    ;
    возврат 2
;
метод InactiveCatch(Ref: Data::Account.Ссылка): Строка
    попытка
        Lock(Ref)
    поймать E: ИсключениеНетАктивнойТранзакции
    возврат E.Описание
    ;
    возврат "wrong"
;
метод Nested(): Число
    исп Транзакции.Начать()
    возврат Inner()
;
метод Inner(): Число
    исп Транзакции.Начать()
    возврат 1
;
метод Unsupported(): Число
    исп Handle = Транзакции.Начать()
    Handle.Фиксировать()
    возврат 1
;
