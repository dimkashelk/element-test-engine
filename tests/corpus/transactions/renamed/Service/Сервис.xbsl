@Глобально
метод Validate(Text: Строка)
    если Text.Пусто()
        выбросить новый ИсключениеВалидации("empty label")
    ;
;
@Глобально
метод First(ID: Ууид, Text: Строка, N: Число): Учет::Контрагенты.Ссылка
    знч O = новый Учет::Контрагенты.Объект(Ид = ID, Название = Text, Итого = N)
    O.Позиции.Добавить(новый Учет::Контрагенты.Позиции(Итого = N))
    O.Записать()
    возврат O.Ссылка
;
@Глобально
метод Second(ID: Ууид, Text: Строка, N: Число)
    знч R = новый Учет::История.НаборЗаписей()
    R.Фильтр.Установить("bucket")
    R.ДобавитьЗапись(Key = "bucket", Итого = N)
    R.Записать()
    знч O = новый Учет::Заявка.Объект(Ид = ID, Название = Text, Итого = N * 2)
    O.Позиции.Добавить(новый Учет::Заявка.Позиции(Итого = N * 2))
    O.Записать()
;
@Глобально
метод Crash()
    выбросить новый ИсключениеВалидации("late dependency")
;
