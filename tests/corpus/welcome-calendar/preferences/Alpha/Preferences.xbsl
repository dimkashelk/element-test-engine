@ДоступноСКлиента
@НаСервере
@ВПроекте
метод Fetch(): Соответствие<Строка, Строка>
    знч Д = Preferences.Получить()
    знч Повтор = Preferences.Получить()
    знч Р = <Строка, Строка>{"value": Д.Address, "again": Повтор.Address}
    Р.Вставить("temporary", "discard")
    Р.Удалить("temporary")
    возврат Р
;
