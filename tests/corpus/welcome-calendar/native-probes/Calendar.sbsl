метод Скрипт()
    знч День = Дата{2026-10-02}
    знч Сейчас = ДатаВремя.Сейчас(ЧасовойПояс{UTC})
    знч В = Время{01:02:03}
    пер Б: Булево
    пер С: Строка
    пер Д: Дата
    знч Словарь = <Строка, Булево>{"present": Истина}
    пер ОшибкаПолучить = ""
    пер ОшибкаИндекс = ""
    попытка
        Словарь.Получить("missing")
    поймать Ошибка: Исключение
        ОшибкаПолучить = Ошибка.ПолучитьТип().ВСтроку()
    ;
    попытка
        знч Нет = Словарь["missing"]
    поймать Ошибка: Исключение
        ОшибкаИндекс = Ошибка.ПолучитьТип().ВСтроку()
    ;
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект({
        "day": День.ДеньНедели().Представление(), "next": День.ДобавитьДни(1),
        "month": Дата{2026-09-30}.ДобавитьДни(1), "year": Дата{2026-12-31}.ДобавитьДни(1),
        "leap": Дата{2028-02-28}.ДобавитьДни(1), "afterLeap": Дата{2028-02-29}.ДобавитьДни(1),
        "compare": День <= День, "time": "${В}", "midnight": "${Время{00:00:00}}",
        "defaults": [Б, С, Д], "missingGet": ОшибкаПолучить, "missingIndex": ОшибкаИндекс,
        "optional": Словарь.ПолучитьИлиНеопределено("missing"), "dictionary": Словарь,
        "now": Сейчас, "date": Дата.Сейчас(), "clock": Время.Сейчас(),
        "snapshotDate": новый Дата(Сейчас.Год, Сейчас.Месяц, Сейчас.День), "snapshotTime": новый Время(Сейчас.Час, Сейчас.Минута, Сейчас.Секунда, Сейчас.Миллисекунда)
    }))
;
