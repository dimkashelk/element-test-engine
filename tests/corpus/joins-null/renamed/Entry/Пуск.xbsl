    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, O.Label КАК Other ИЗ Учет::Клиенты КАК L ЛЕВОЕ СОЕДИНЕНИЕ Учет::Записи КАК R ПО L.Номер == R.Номер ПОЛНОЕ СОЕДИНЕНИЕ Other::Клиенты КАК O ПО O.Номер == R.Номер}.Выполнить()
;
