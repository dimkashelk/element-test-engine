    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Сумма.ЗаменитьNull(0) КАК Amount, R.Note.ЗаменитьNull("missing") КАК Note, R.Note ЕСТЬ NULL КАК Absent ИЗ Учет::Клиенты КАК L ЛЕВОЕ СОЕДИНЕНИЕ Учет::Записи КАК R ПО L.Номер == R.Номер УПОРЯДОЧИТЬ ПО Left, Amount}.Выполнить()
;
