    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right ИЗ Учет::Клиенты КАК L СОЕДИНЕНИЕ Учет::Клиенты КАК R ПО L.Номер == R.Номер}.Выполнить()
;
метод RefJoin(): Объект
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right ИЗ Учет::Клиенты КАК L СОЕДИНЕНИЕ Учет::Записи КАК R ПО L.Ссылка == R.Peer}.Выполнить()
;
метод Detached(): Объект
    знч Old = Left()
    знч Fresh = Left()
    Fresh[0].Ref.Идентификатор = новый Ууид("99999999-9999-4999-8999-999999999999")
    Fresh[0].Amount = 700
    возврат {"old": Old, "fresh": Fresh, "again": Left()}
;
метод Unsupported(): Объект
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left ИЗ Учет::Клиенты КАК L ЛЕВОЕ СОЕДИНЕНИЕ Учет::Записи КАК R ПО L.Номер == R.Номер ГДЕ R.Номер В (1, "bad-type")}.Выполнить()
;
метод Write(N: Число)
    знч V = новый Учет::Записи.Объект(Ссылка = Учет::Записи.ПолучитьСсылку(новый Ууид("44444444-4444-4444-8444-444444444444")), Номер = 1, Label = "x", Сумма = N)
    V.Записать()
;
метод Capture(Calls: Массив<Строка>, K: Число): Число
    Calls.Добавить("key")
    возврат K
;
метод State(K: Число): Объект
    знч Calls = новый Массив<Строка>()
    знч Q = Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Сумма КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Учет::Клиенты КАК L ЛЕВОЕ СОЕДИНЕНИЕ Учет::Записи КАК R ПО L.Номер == R.Номер ГДЕ L.Номер == %{Capture(Calls, K)}}
    знч Old = Q.Выполнить()
    пер Seen = новый Массив<Result>()
    пер Again = новый Массив<Result>()
    попытка
        исп Транзакции.Начать()
        Write(17)
        Seen = Q.Выполнить()
        Seen[0].Amount = 700
        Again = Q.Выполнить()
        выбросить новый ИсключениеВалидации("rollback")
    поймать E: ИсключениеВалидации
        возврат {"old": Old, "seen": Seen, "again": Again, "after": Q.Выполнить(), "calls": Calls}
    ;
;
метод Swallow(): Строка
    попытка
        Left()
    поймать E: Исключение
        возврат "caught"
    ;
    возврат "ok"
;
