импорт Data::Card как Result
метод Inner(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ВНУТРЕННЕЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key}.Выполнить()
;
метод Left(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key}.Выполнить()
;
метод Right(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ПРАВОЕ ВНЕШНЕЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key}.Выполнить()
;
метод Full(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ПОЛНОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key}.Выполнить()
;
метод Missing(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ГДЕ R.Key ЕСТЬ NULL}.Выполнить()
;
метод Present(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ГДЕ R.Key ЕСТЬ НЕ NULL}.Выполнить()
;
метод UnknownNot(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ГДЕ НЕ (R.Amount == 3)}.Выполнить()
;
метод NullComparison(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ГДЕ R.Amount == NULL}.Выполнить()
;
метод Or(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ГДЕ R.Key ЕСТЬ NULL ИЛИ R.Amount == 3}.Выполнить()
;
метод FalseAnd(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ГДЕ Ложь И НЕ (R.Amount == 3)}.Выполнить()
;
метод OptionalMissing(): Массив<Result>
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ГДЕ R.Note == Неопределено}.Выполнить()
;
метод Coalesce(): Объект
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Amount.ЗаменитьNull(0) КАК Amount, R.Note.ЗаменитьNull("missing") КАК Note, R.Note ЕСТЬ NULL КАК Absent ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key УПОРЯДОЧИТЬ ПО Left, Amount}.Выполнить()
;
метод Default(): Объект
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Amount.ЗаменитьNull() КАК Amount ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key УПОРЯДОЧИТЬ ПО Left, Amount}.Выполнить()
;
метод Nested(): Объект
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, O.Label КАК Other ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ПОЛНОЕ СОЕДИНЕНИЕ Other::Item КАК O ПО O.Key == R.Key}.Выполнить()
;
метод Self(): Объект
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right ИЗ Data::Item КАК L СОЕДИНЕНИЕ Data::Item КАК R ПО L.Key == R.Key}.Выполнить()
;
метод RefJoin(): Объект
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right ИЗ Data::Item КАК L СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Ссылка == R.Peer}.Выполнить()
;
метод Detached(): Объект
    знч Old = Left()
    знч Fresh = Left()
    Fresh[0].Ref.Идентификатор = новый Ууид("99999999-9999-4999-8999-999999999999")
    Fresh[0].Amount = 700
    возврат {"old": Old, "fresh": Fresh, "again": Left()}
;
метод Unsupported(): Объект
    возврат Запрос{ВЫБРАТЬ L.Label КАК Left ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ГДЕ R.Key В (1, 2)}.Выполнить()
;
метод Write(N: Число)
    знч V = новый Data::Entry.Объект(Ссылка = Data::Entry.ПолучитьСсылку(новый Ууид("44444444-4444-4444-8444-444444444444")), Key = 1, Label = "x", Amount = N)
    V.Записать()
;
метод Capture(Calls: Массив<Строка>, K: Число): Число
    Calls.Добавить("key")
    возврат K
;
метод State(K: Число): Объект
    знч Calls = новый Массив<Строка>()
    знч Q = Запрос{ВЫБРАТЬ L.Label КАК Left, R.Label КАК Right, R.Amount КАК Amount, R.Note КАК Note, L.Ссылка КАК Ref, L.Ссылка КАК Second ЗАПОЛНИТЬ Result ИЗ Data::Item КАК L ЛЕВОЕ СОЕДИНЕНИЕ Data::Entry КАК R ПО L.Key == R.Key ГДЕ L.Key == %{Capture(Calls, K)}}
    знч Old = Q.Выполнить()
    пер Seen = новый Массив<Result>()
    пер Again = новый Массив<Result>()
    попытка
        исп Транзакции.Начать()
        Write(17)
        Seen = Q.Выполнить()
        Seen[0].Amount = 700
        Again = Q.Выполнить()
        выбросить новый ИсключениеВалидации("rollback")
    поймать E: ИсключениеВалидации
        возврат {"old": Old, "seen": Seen, "again": Again, "after": Q.Выполнить(), "calls": Calls}
    ;
;
метод Swallow(): Строка
    попытка
        Left()
    поймать E: Исключение
        возврат "caught"
    ;
    возврат "ok"
;
