структура Снимок
    пер Note: Строка?
    пер Amount: Число
;
метод Скрипт(): Объект
    пер Missing: Снимок? = Неопределено
    знч Present = новый Снимок(Note = Неопределено, Amount = 0)
    возврат {"missing": Missing == Неопределено, "optional": Present.Note == Неопределено,
        "amount": Present.Amount, "date": новый Дата(2025, 1, 1),
        "uuid": новый Ууид("11111111-1111-4111-8111-111111111111")}
;
