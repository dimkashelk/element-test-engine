// Session state lives only in the isolated container's /tmp.
@Глобально
структура Маркер
;
@Глобально
структура Регистрация
    пер Обработчик: Строка
    пер Интервал: Число
    пер Срок: Число
    пер Порядок: Число
    пер Однократно: Булево
;
структура Сессия
    пер Сейчас: Число = 0
    пер Порядок: Число = 0
    пер Исполнено: Число = 0
    пер Лимит: Число = 1000
    пер Закрыта: Булево = Ложь
    пер ОтмененоПриЗакрытии: Число = 0
    пер Активные: Массив<Регистрация> = []
;
конст Путь = "/tmp/element-timers.json"
метод Читать(): Сессия
    исп Поток = новый Файл(Путь).ОткрытьПотокЧтения()
    возврат СериализацияJson.ПрочитатьОбъект<Сессия>(Поток, Тип<Сессия>)
;
метод Записать(С: Сессия)
    исп Поток = новый Файл(Путь).ОткрытьПотокЗаписи()
    СериализацияJson.ЗаписатьОбъект(Поток, С)
;
метод Проверить(С: Сессия)
    если С.Закрыта
        выбросить новый ИсключениеНедопустимоеСостояние("Сессия таймеров закрыта")
    ;
;
метод УдалитьПоИмени(С: Сессия, Обработчик: Строка)
    знч Остались = новый Массив<Регистрация>()
    для Т из С.Активные
        если Т.Обработчик != Обработчик
            Остались.Добавить(Т)
        ;
    ;
    С.Активные = Остались
;
@Глобально
метод Инициализировать(Лимит: Число)
    знч С = новый Сессия()
    С.Лимит = Лимит
    Записать(С)
;
@Глобально
метод ПодключитьОбработчикТаймера(Обработчик: Строка, Интервал: Длительность, Однократно: Булево = Ложь)
    знч С = Читать()
    Проверить(С)
    знч Мс = Интервал.ВМиллисекундах()
    если Мс < 0 или (Мс == 0 и не Однократно)
        выбросить новый ИсключениеНедопустимыйАргумент("Таймер требует положительный период или однократный нулевой интервал")
    ;
    УдалитьПоИмени(С, Обработчик)
    если С.Активные.Размер() >= 1000
        выбросить новый ИсключениеНеподдерживаемаяОперация("Лимит активных таймеров")
    ;
    С.Порядок += 1
    С.Активные.Добавить(новый Регистрация(Обработчик, Мс, С.Сейчас + Мс, С.Порядок, Однократно))
    Записать(С)
;
@Глобально
метод ОтключитьОбработчикТаймера(Обработчик: Строка)
    знч С = Читать()
    Проверить(С)
    УдалитьПоИмени(С, Обработчик)
    Записать(С)
;
@Глобально
метод ТекущееВремя(): Число
    возврат Читать().Сейчас
;
@Глобально
метод Продвинуть(Срок: Число)
    знч С = Читать()
    Проверить(С)
    ТестЧасы.Сдвинуть(Срок - С.Сейчас)
    С.Сейчас = Срок
    Записать(С)
;
@Глобально
метод Следующее(Граница: Число, ОдинШаг: Булево): Регистрация?
    знч С = Читать()
    Проверить(С)
    пер Выбран: Регистрация? = Неопределено
    для Т из С.Активные
        если (ОдинШаг или Т.Срок <= Граница) и (Выбран == Неопределено или Т.Срок < Выбран.Срок или (Т.Срок == Выбран.Срок и Т.Порядок < Выбран.Порядок))
            Выбран = Т
        ;
    ;
    если Выбран == Неопределено
        возврат Неопределено
    ;
    если С.Исполнено >= С.Лимит
        выбросить новый ИсключениеНеподдерживаемаяОперация("Превышен maxEvents таймера")
    ;
    С.Исполнено += 1
    С.Активные.Удалить(Выбран)
    если не Выбран.Однократно
        С.Активные.Добавить(новый Регистрация(Выбран.Обработчик, Выбран.Интервал, Выбран.Срок + Выбран.Интервал, Выбран.Порядок, Ложь))
    ;
    ТестЧасы.Сдвинуть(Выбран.Срок - С.Сейчас)
    С.Сейчас = Выбран.Срок
    Записать(С)
    возврат Выбран
;
@Глобально
метод Закрыть()
    знч С = Читать()
    если не С.Закрыта
        С.ОтмененоПриЗакрытии = С.Активные.Размер()
        С.Активные.Очистить()
        С.Закрыта = Истина
        Записать(С)
    ;
;
@Глобально
метод Наблюдение(): Соответствие<Строка, Объект?>
    знч С = Читать()
    знч Активные = новый Массив<Соответствие<Строка, Объект?>>()
    для Т из С.Активные
        Активные.Добавить({"callback": Т.Обработчик, "intervalMs": Т.Интервал, "dueMs": Т.Срок, "order": Т.Порядок, "once": Т.Однократно})
    ;
    возврат {"elapsedMs": С.Сейчас, "active": Активные, "executed": С.Исполнено, "closed": С.Закрыта, "cancelledOnClose": С.ОтмененоПриЗакрытии}
;
