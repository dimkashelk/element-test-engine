// Explicit standalone emulation. Text is parsed only when Выполнить is called.
@Глобально
структура Токен
    знч Текст: Строка
    знч Начало: Число
;
@Глобально
структура Проекция
    знч Поле: Строка
    знч Имя: Строка
;
@Глобально
структура Условие
    знч Поле: Строка
    знч Операция: Строка
    знч Значение: Объект?
;
@Глобально
структура Порядок
    знч Поле: Строка
    знч Убыв: Булево
;
@Глобально
структура Дерево
    знч Источник: Строка
    знч Проекции: Массив<Проекция>
    знч Условия: Массив<Условие>
    знч Порядок: Массив<Порядок>
    знч Предел: Число
;
@Глобально
метод Лексер(Текст: Строка): Массив<Токен>
    знч Токены = новый Массив<Токен>()
    пер П = 0
    пока П < Текст.Длина()
        знч Символ = Текст.Подстрока(П, П + 1)
        если Символ == " " или Символ == "\n" или Символ == "\r" или Символ == "\t"
            П += 1
            продолжить
        ;
        если Символ == "/" и П + 1 < Текст.Длина() и Текст.Подстрока(П + 1, П + 2) == "/"
            пока П < Текст.Длина() и Текст.Подстрока(П, П + 1) != "\n"
                П += 1
            ;
            продолжить
        ;
        знч Начало = П
        П += 1
        если Символ == "\""
            пер Закрыта = Ложь
            пока П < Текст.Длина()
                знч С = Текст.Подстрока(П, П + 1)
                П += 1
                если С == "\\"
                    П += 1
                иначе если С == "\""
                    Закрыта = Истина
                    прервать
                ;
            ;
            если не Закрыта
                выбросить новый ИсключениеНедопустимыйАргумент("Незакрытая строка запроса")
            ;
        иначе если Символ == ","
            // punctuation
        иначе если Символ == "=" или Символ == "!" или Символ == ">" или Символ == "<"
            если П < Текст.Длина() и Текст.Подстрока(П, П + 1) == "="
                П += 1
            ;
        иначе
            пока П < Текст.Длина()
                знч С = Текст.Подстрока(П, П + 1)
                если С == " " или С == "\n" или С == "\r" или С == "\t" или С == "," или С == "=" или С == "!" или С == ">" или С == "<"
                    прервать
                ;
                П += 1
            ;
        ;
        Токены.Добавить(новый Токен(Текст = Текст.Подстрока(Начало, П), Начало = Начало))
    ;
    возврат Токены
;
@Глобально
структура Разбор
    знч Токены: Массив<Токен>
    пер П: Число = 0
    знч Параметры: Соответствие<Строка, Объект?>
    метод Смотреть(): Строка
        возврат П < Токены.Размер() ? Токены[П].Текст.ВВерхнийРегистр() : ""
    ;
    метод Взять(): Строка
        если П >= Токены.Размер()
            выбросить новый ИсключениеНедопустимыйАргумент("Неожиданный конец запроса")
        ;
        знч Значение = Токены[П].Текст
        П += 1
        возврат Значение
    ;
    метод Требовать(Слово: Строка)
        если Смотреть() != Слово
            выбросить новый ИсключениеНедопустимыйАргумент("Ожидалось " + Слово + ", позиция " + П.ВСтроку())
        ;
        Взять()
    ;
    метод Поле(Имя: Строка, Псевдоним: Строка): Строка
        если Псевдоним != "" и Имя.НачинаетсяС(Псевдоним + ".")
            возврат Имя.Подстрока(Псевдоним.Длина() + 1)
        ;
        возврат Имя
    ;
    метод Значение(): Объект?
        знч Текст = Взять()
        если Текст.НачинаетсяС("&")
            знч Имя = Текст.Подстрока(1)
            если не Параметры.СодержитКлюч(Имя)
                выбросить новый ИсключениеНедопустимоеСостояние("Не установлен параметр запроса: " + Имя)
            ;
            возврат Параметры[Имя]
        ;
        если Текст.ВВерхнийРегистр() == "НЕОПРЕДЕЛЕНО" или Текст.ВВерхнийРегистр() == "NULL"
            возврат Неопределено
        ;
        если Текст.ВВерхнийРегистр() == "ИСТИНА"
            возврат Истина
        ;
        если Текст.ВВерхнийРегистр() == "ЛОЖЬ"
            возврат Ложь
        ;
        знч Значение: Объект? = СериализацияJson.ПрочитатьОбъект(Текст)
        если не (Значение это Строка) и не (Значение это Число)
            выбросить новый ИсключениеНедопустимыйАргумент("Требуется скалярное значение запроса")
        ;
        возврат Значение
    ;
    @Глобально
    метод Прочитать(): Дерево
        Требовать("ВЫБРАТЬ")
        пер Предел = -1
        если Смотреть() == "ПЕРВЫЕ"
            Взять()
            Предел = Значение() как Число
            если Предел < 0 или Предел != Предел.Округлить(0)
                выбросить новый ИсключениеНедопустимыйАргумент("ПЕРВЫЕ требует неотрицательное целое")
            ;
        ;
        знч Проекции = новый Массив<Проекция>()
        пока Истина
            знч Поле = Взять()
            пер Имя = Поле
            если Смотреть() == "КАК"
                Взять()
                Имя = Взять()
            ;
            Проекции.Добавить(новый Проекция(Поле = Поле, Имя = Имя))
            если Смотреть() != ","
                прервать
            ;
            Взять()
        ;
        Требовать("ИЗ")
        знч Источник = Взять()
        пер Псевдоним = ""
        если Смотреть() == "КАК"
            Взять()
            Псевдоним = Взять()
        ;
        пер Н = 0
        пока Н < Проекции.Размер()
            знч С = Проекции[Н]
            Проекции[Н] = новый Проекция(Поле = Поле(С.Поле, Псевдоним), Имя = Поле(С.Имя, Псевдоним))
            Н += 1
        ;
        знч Условия = новый Массив<Условие>()
        если Смотреть() == "ГДЕ"
            Взять()
            пока Истина
                знч Имя = Поле(Взять(), Псевдоним)
                знч Операция = Взять()
                если Операция != "==" и Операция != "=" и Операция != "!=" и Операция != ">" и Операция != "<" и Операция != ">=" и Операция != "<="
                    выбросить новый ИсключениеНеподдерживаемаяОперация("Операция runtime-запроса: " + Операция)
                ;
                Условия.Добавить(новый Условие(Поле = Имя, Операция = Операция, Значение = Значение()))
                если Смотреть() != "И"
                    прервать
                ;
                Взять()
            ;
        ;
        знч Порядок = новый Массив<Порядок>()
        если Смотреть() == "УПОРЯДОЧИТЬ"
            Взять()
            Требовать("ПО")
            пока Истина
                знч Имя = Поле(Взять(), Псевдоним)
                знч Убыв = Смотреть() == "УБЫВ"
                если Убыв или Смотреть() == "ВОЗР"
                    Взять()
                ;
                Порядок.Добавить(новый Порядок(Поле = Имя, Убыв = Убыв))
                если Смотреть() != ","
                    прервать
                ;
                Взять()
            ;
        ;
        если П != Токены.Размер()
            выбросить новый ИсключениеНеподдерживаемаяОперация("Форма runtime-запроса вне эмулируемого контракта: " + Смотреть())
        ;
        возврат новый Дерево(Источник = Источник, Проекции = Проекции, Условия = Условия, Порядок = Порядок, Предел = Предел)
    ;
;
@Глобально
метод Сравнить(А: Объект?, Б: Объект?): Число
    если А == Б
        возврат 0
    ;
    если А == Неопределено
        возврат -1
    ;
    если Б == Неопределено
        возврат 1
    ;
    если А это Число и Б это Число
        возврат (А как Число) < (Б как Число) ? -1 : 1
    ;
    если А это Строка и Б это Строка
        возврат (А как Строка) < (Б как Строка) ? -1 : 1
    ;
    если А это Дата и Б это Дата
        возврат (А как Дата) < (Б как Дата) ? -1 : 1
    ;
    выбросить новый ИсключениеНеподдерживаемаяОперация("Сортировка runtime-запроса требует число, строку или дату")
;
@Глобально
метод Раньше(А: Соответствие<Строка, Объект?>, Б: Соответствие<Строка, Объект?>, Порядок: Массив<Порядок>): Булево
    для С из Порядок
        знч Разница = Сравнить(А[С.Поле], Б[С.Поле])
        если Разница != 0
            возврат С.Убыв ? Разница > 0 : Разница < 0
        ;
    ;
    возврат Ложь
;
@Глобально
метод Выполнить(Дерево: Дерево, Исходные: Массив<Соответствие<Строка, Объект?>>, Колонки: Массив<ТестКолонкаЗапроса.Описание>): Массив<Объект?>
    знч Описания = новый Соответствие<Строка, ТестКолонкаЗапроса.Описание>()
    для К из Колонки
        Описания[К.Имя] = К
    ;
    знч Имена = новый Множество<Строка>()
    для П из Дерево.Проекции
        если Имена.Содержит(П.Имя)
            выбросить новый ИсключениеНедопустимыйАргумент("Повторное имя колонки: " + П.Имя)
        ;
        Имена.Добавить(П.Имя)
        если не Описания.СодержитКлюч(П.Поле)
            выбросить новый ИсключениеНедопустимыйАргумент("Неизвестная колонка: " + П.Поле)
        ;
    ;
    для П из Дерево.Порядок
        если не Описания.СодержитКлюч(П.Поле)
            выбросить новый ИсключениеНедопустимыйАргумент("Неизвестное поле сортировки: " + П.Поле)
        ;
    ;
    для У из Дерево.Условия
        если не Описания.СодержитКлюч(У.Поле) или не Описания[У.Поле].ТестТип.Типы.Содержит(У.Значение.ПолучитьТип())
            выбросить новый ИсключениеНедопустимыйАргумент("Неверное поле или тип параметра: " + У.Поле)
        ;
    ;
    знч Отбор = новый Массив<Соответствие<Строка, Объект?>>()
    для С из Исходные
        пер Подходит = Истина
        для У из Дерево.Условия
            знч А = С[У.Поле]
            знч Б = У.Значение
            если А == Неопределено или Б == Неопределено
                Подходит = Ложь
            иначе если У.Операция == "=" или У.Операция == "=="
                Подходит = Подходит и А == Б
            иначе если У.Операция == "!="
                Подходит = Подходит и А != Б
            иначе
                знч Знак = Сравнить(А, Б)
                Подходит = Подходит и (У.Операция == ">" ? Знак > 0 : У.Операция == "<" ? Знак < 0 : У.Операция == ">=" ? Знак >= 0 : Знак <= 0)
            ;
        ;
        если не Подходит
            продолжить
        ;
        пер П = 0
        пока П < Отбор.Размер() и не Раньше(С, Отбор[П], Дерево.Порядок)
            П += 1
        ;
        Отбор.Вставить(П, С)
    ;
    знч Результат = новый Массив<Объект?>()
    для С из Отбор
        если Дерево.Предел >= 0 и Результат.Размер() >= Дерево.Предел
            прервать
        ;
        знч Значение = новый Соответствие<Строка, Объект?>()
        для П из Дерево.Проекции
            если Значение.СодержитКлюч(П.Имя)
                выбросить новый ИсключениеНедопустимыйАргумент("Повторное имя колонки: " + П.Имя)
            ;
            Значение[П.Имя] = С[П.Поле]
        ;
        Результат.Добавить(Значение)
    ;
    возврат Результат
;
@Глобально
метод Колонки(Дерево: Дерево, Исходные: Массив<ТестКолонкаЗапроса.Описание>): Массив<ТестКолонкаЗапроса.Описание>
    знч Результат = новый Массив<ТестКолонкаЗапроса.Описание>()
    для П из Дерево.Проекции
        для К из Исходные
            если К.Имя == П.Поле
                Результат.Добавить(новый ТестКолонкаЗапроса.Описание(Имя = П.Имя, ТестТип = К.ТестТип))
            ;
        ;
    ;
    возврат Результат
;
@Глобально
метод Прочитать(Строка: Соответствие<Строка, Объект?>, Ключ: Строка): Объект?
    если не Строка.СодержитКлюч(Ключ)
        выбросить новый ИсключениеНедопустимыйАргумент("Неизвестная колонка: " + Ключ)
    ;
    возврат Строка[Ключ]
;
