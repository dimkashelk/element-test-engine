// Входной контракт — JSON IR. YAML и архивы обрабатываются внешним адаптером.
метод Скрипт(Команда: Строка, ПутьМодели: Строка, ПутьЗадания: Строка = ""): Число
    знч Модель = ПрочитатьМодель(ПутьМодели)
    если Команда == "inspect"
        Консоль.Записать(СериализацияJson.ЗаписатьОбъект(Модель))
        возврат 0
    ;
    если Команда == "validate"
        знч Диагностика = МассивЗначений(Модель.ПолучитьИлиНеопределено("diagnostics"))
        пер Ошибки = 0
        для Значение из Диагностика
            знч Сообщение = ОбъектЗначение(Значение)
            если Сообщение.ПолучитьИлиНеопределено("severity") != "warning"
                Ошибки += 1
            ;
        ;
        Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"valid": Ошибки == 0, "diagnostics": Диагностика}))
        возврат Ошибки == 0 ? 0 : 1
    ;
    знч Задание = ПрочитатьМодель(ПутьЗадания)
    знч Результат = ВыполнитьПроверки(Модель, Задание)
    Консоль.Записать(СериализацияJson.ЗаписатьОбъект(Результат))
    возврат Результат.ПолучитьИлиНеопределено("status") == "passed" ? 0 : 1
;

// Exact decimal transport is decoded independently of the Python generator.
метод ЗначениеГенерации(Значение: Объект?): Объект?
    если Значение это Соответствие<Строка, Объект?>
        знч Поля = Значение как Соответствие<Строка, Объект?>
        если Поля.Размер() == 1 и Поля.СодержитКлюч("decimal")
            возврат новый Число(Поля["decimal"] как Строка)
        ;
        знч Копия = новый Соответствие<Строка, Объект?>()
        для Пара из Поля
            Копия.Вставить(Пара.Ключ, ЗначениеГенерации(Пара.Значение))
        ;
        возврат Копия
    ;
    если Значение это Массив<Объект?>
        знч Копия = новый Массив<Объект?>()
        для Элемент из Значение как Массив<Объект?>
            Копия.Добавить(ЗначениеГенерации(Элемент))
        ;
        возврат Копия
    ;
    возврат Значение
;

метод ТекстДатыИнварианта(Значение: Объект): Строка
    возврат СериализацияJson.ПрочитатьОбъект<Строка>(СериализацияJson.ЗаписатьОбъект(Значение), Тип<Строка>)
;

// Teacher expression IR is separate from student source and is evaluated here.
метод ЗначениеИнварианта(Выражение: Соответствие<Строка, Объект?>, Случай: Соответствие<Строка, Объект?>): Объект?
    если Выражение.СодержитКлюч("literal")
        возврат ЗначениеГенерации(Выражение.Получить("literal"))
    ;
    если Выражение.СодержитКлюч("arg")
        возврат ЗначениеГенерации((Случай.Получить("inputs") как Массив<Объект?>)[Выражение.Получить("arg") как Число])
    ;
    если Выражение.СодержитКлюч("result")
        возврат ЗначениеГенерации(Случай.Получить("result"))
    ;
    если Выражение.СодержитКлюч("pairedResult")
        возврат ЗначениеГенерации(Случай.Получить("pairedResult"))
    ;
    знч Операция = Выражение.Получить("op") как Строка
    знч Аргументы = Выражение.Получить("args") как Массив<Объект?>
    знч А = ЗначениеИнварианта(ОбъектЗначение(Аргументы[0]), Случай)
    выбор Операция
    когда "number"
        возврат А это Число ? А : новый Число(А как Строка)
    когда "date"
        возврат новый Дата(А как Строка)
    когда "dateTime"
        возврат новый ДатаВремя(А как Строка)
    когда "instant"
        возврат новый Момент(А как Строка)
    ;
    // Preserve short circuit in the independent relation as well.
    если Операция == "and"
        возврат (А как Булево) и (ЗначениеИнварианта(ОбъектЗначение(Аргументы[1]), Случай) как Булево)
    ;
    если Операция == "or"
        возврат (А как Булево) или (ЗначениеИнварианта(ОбъектЗначение(Аргументы[1]), Случай) как Булево)
    ;
    если Операция == "not"
        возврат не (А как Булево)
    ;
    если Операция == "length"
        возврат А это Строка ? (А как Строка).Длина() : (А как Массив<Объект?>).Размер()
    ;
    если Операция == "sum"
        пер Сумма = 0
        для Элемент из А как Массив<Объект?>
            Сумма += Элемент как Число
        ;
        возврат Сумма
    ;
    если Операция == "reverse"
        если А это Строка
            знч СтрокаА = А как Строка
            пер Обратная = ""
            пер ИндексСимвола = СтрокаА.Длина() - 1
            пока ИндексСимвола >= 0
                Обратная += СтрокаА.Подстрока(ИндексСимвола, ИндексСимвола + 1)
                ИндексСимвола -= 1
            ;
            возврат Обратная
        ;
        знч Массив = А как Массив<Объект?>
        знч Обратный = новый Массив<Объект?>()
        пер Индекс = Массив.Размер() - 1
        пока Индекс >= 0
            Обратный.Добавить(Массив[Индекс])
            Индекс -= 1
        ;
        возврат Обратный
    ;
    знч Б = ЗначениеИнварианта(ОбъектЗначение(Аргументы[1]), Случай)
    выбор Операция
    когда "set"
        знч Копия = новый Соответствие<Строка, Объект?>(ОбъектЗначение(А))
        знч Ключ = Б как Строка
        если не Копия.СодержитКлюч(Ключ)
            выбросить новый ИсключениеНедопустимыйАргумент("set требует существующее поле")
        ;
        Копия.Вставить(Ключ, ЗначениеИнварианта(ОбъектЗначение(Аргументы[2]), Случай))
        возврат Копия
    когда "dateAddDays"
        знч Текст = А как Строка
        если Текст.ЗаканчиваетсяНа("Z")
            возврат ТекстДатыИнварианта((новый Момент(Текст)) + Длительность.ИзДней(Б как Число))
        ;
        если Текст.Содержит("T")
            возврат ТекстДатыИнварианта((новый ДатаВремя(Текст)).ДобавитьДни(Б как Число))
        ;
        возврат ТекстДатыИнварианта((новый Дата(Текст)).ДобавитьДни(Б как Число))
    когда "dateAddSeconds"
        знч Текст = А как Строка
        возврат Текст.ЗаканчиваетсяНа("Z") ? ТекстДатыИнварианта((новый Момент(Текст)) + Длительность.ИзСекунд(Б как Число)) : ТекстДатыИнварианта((новый ДатаВремя(Текст)).ДобавитьСекунды(Б как Число))
    когда "get"
        возврат ОбъектЗначение(А).Получить(Б как Строка)
    когда "at"
        возврат (А как Массив<Объект?>)[Б как Число]
    когда "equal"
        возврат А == Б
    когда "notEqual"
        возврат А != Б
    когда "less"
        если А это Дата и Б это Дата
            возврат (А как Дата) < (Б как Дата)
        ;
        если А это ДатаВремя и Б это ДатаВремя
            возврат (А как ДатаВремя) < (Б как ДатаВремя)
        ;
        если А это Момент и Б это Момент
            возврат (А как Момент) < (Б как Момент)
        ;
        возврат (А как Число) < (Б как Число)
    когда "lessEqual"
        если А это Дата и Б это Дата
            возврат (А как Дата) <= (Б как Дата)
        ;
        если А это ДатаВремя и Б это ДатаВремя
            возврат (А как ДатаВремя) <= (Б как ДатаВремя)
        ;
        если А это Момент и Б это Момент
            возврат (А как Момент) <= (Б как Момент)
        ;
        возврат (А как Число) <= (Б как Число)
    когда "greater"
        если А это Дата и Б это Дата
            возврат (А как Дата) > (Б как Дата)
        ;
        если А это ДатаВремя и Б это ДатаВремя
            возврат (А как ДатаВремя) > (Б как ДатаВремя)
        ;
        если А это Момент и Б это Момент
            возврат (А как Момент) > (Б как Момент)
        ;
        возврат (А как Число) > (Б как Число)
    когда "greaterEqual"
        если А это Дата и Б это Дата
            возврат (А как Дата) >= (Б как Дата)
        ;
        если А это ДатаВремя и Б это ДатаВремя
            возврат (А как ДатаВремя) >= (Б как ДатаВремя)
        ;
        если А это Момент и Б это Момент
            возврат (А как Момент) >= (Б как Момент)
        ;
        возврат (А как Число) >= (Б как Число)
    когда "add"
        возврат (А как Число) + (Б как Число)
    когда "subtract"
        возврат (А как Число) - (Б как Число)
    когда "multiply"
        возврат (А как Число) * (Б как Число)
    ;
    выбросить новый ИсключениеНедопустимоеСостояние("Неизвестный оператор отношения")
;

метод ПроверитьИнвариант(Контракт: Соответствие<Строка, Объект?>, Факт: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>
    попытка
        знч Случаи = Факт.Получить("cases") как Массив<Объект?>
        если Случаи.Пусто()
            возврат {"status": "ERROR", "reasonCode": "invalid_test", "message": "Нет генеративных исполнений"}
        ;
        пер Индекс = 0
        для Случай из Случаи
            знч Отношение = ЗначениеИнварианта(ОбъектЗначение(Контракт.Получить("relation")), ОбъектЗначение(Случай))
            если не (Отношение это Булево)
                возврат {"status": "ERROR", "reasonCode": "invalid_test", "message": "Отношение должно возвращать Булево"}
            ;
            если не (Отношение как Булево)
                возврат {"status": "FAIL", "counterexampleIndex": Индекс, "expected": Истина, "actual": Случай}
            ;
            Индекс += 1
        ;
        возврат {"status": "PASS", "expected": Истина, "actual": {"verifiedCases": Индекс}}
    поймать Ошибка: Исключение
        возврат {"status": "ERROR", "reasonCode": "invalid_test", "message": "Некорректное независимое отношение: " + Ошибка.Описание}
    ;
;

метод ПрочитатьМодель(Путь: Строка): Соответствие<Строка, Объект?>
    исп Поток = новый Файл(Путь).ОткрытьПотокЧтения()
    возврат СериализацияJson.ПрочитатьСоответствие(Поток.ПрочитатьКакСтроку())
;

метод ОбъектЗначение(Значение: Объект?): Соответствие<Строка, Объект?>
    возврат Значение как Соответствие<Строка, Объект?>
;

метод МассивЗначений(Значение: Объект?): Массив<Объект?>
    если Значение == Неопределено
        возврат новый Массив<Объект?>()
    ;
    возврат Значение как Массив<Объект?>
;

метод Найти(Значения: Объект?, Имя: Строка, Ключ: Строка = "Имя"): Соответствие<Строка, Объект?>?
    пер Результат: Соответствие<Строка, Объект?>?
    для Значение из МассивЗначений(Значения)
        знч Объект = ОбъектЗначение(Значение)
        если Объект.ПолучитьИлиНеопределено(Ключ) == Имя
            если Результат != Неопределено
                выбросить новый ИсключениеНедопустимыйАргумент("Неоднозначное имя: ${Имя}")
            ;
            Результат = Объект
        ;
    ;
    возврат Результат
;

метод НайтиЭлемент(Модель: Соответствие<Строка, Объект?>, Имя: Строка): Соответствие<Строка, Объект?>?
    если не Имя.Содержит("::")
        возврат Найти(Модель.ПолучитьИлиНеопределено("elements"), Имя, "name")
    ;
    пер Результат: Соответствие<Строка, Объект?>?
    для Значение из МассивЗначений(Модель.ПолучитьИлиНеопределено("elements"))
        знч Элемент = ОбъектЗначение(Значение)
        знч КвалифицированноеИмя = (Элемент.ПолучитьИлиНеопределено("namespace") как Строка) + "::" + (Элемент.ПолучитьИлиНеопределено("name") как Строка)
        если КвалифицированноеИмя == Имя
            если Результат != Неопределено
                выбросить новый ИсключениеНедопустимыйАргумент("Неоднозначное имя: ${Имя}")
            ;
            Результат = Элемент
        ;
    ;
    возврат Результат
;

метод НайтиМодуль(Модель: Соответствие<Строка, Объект?>, Имя: Строка, Пространство: Объект?): Соответствие<Строка, Объект?>?
    пер Результат: Соответствие<Строка, Объект?>?
    для Значение из МассивЗначений(Модель.ПолучитьИлиНеопределено("modules"))
        знч Модуль = ОбъектЗначение(Значение)
        если Модуль.ПолучитьИлиНеопределено("name") == Имя и (Пространство == Неопределено или Модуль.ПолучитьИлиНеопределено("namespace") == Пространство)
            если Результат != Неопределено
                выбросить новый ИсключениеНедопустимыйАргумент("Неоднозначный модуль: ${Имя}")
            ;
            Результат = Модуль
        ;
    ;
    возврат Результат
;

метод ПроверитьСвойства(Проверка: Соответствие<Строка, Объект?>, Свойства: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>?
    знч Ожидается = ОбъектЗначение(Проверка.ПолучитьИлиНеопределено("properties"))
    для Пара из Ожидается
        если Свойства.ПолучитьИлиНеопределено(Пара.Ключ) != Пара.Значение
            возврат {"status": "FAIL", "message": "Свойство не совпадает: ${Пара.Ключ}", "expected": Пара.Значение, "actual": Свойства.ПолучитьИлиНеопределено(Пара.Ключ)}
        ;
    ;
    возврат Неопределено
;

метод ВыбратьМодельПроверки(Модель: Соответствие<Строка, Объект?>, Проверка: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>?
    если Проверка.ПолучитьИлиНеопределено("library") == Неопределено
        возврат Модель
    ;
    знч Селектор = ОбъектЗначение(Проверка.ПолучитьИлиНеопределено("library"))
    пер Выбранная: Соответствие<Строка, Объект?>?
    для Значение из МассивЗначений(Модель.ПолучитьИлиНеопределено("libraries"))
        знч Библиотека = ОбъектЗначение(Значение)
        если Библиотека.ПолучитьИлиНеопределено("provider") == Селектор.ПолучитьИлиНеопределено("provider")
            и Библиотека.ПолучитьИлиНеопределено("name") == Селектор.ПолучитьИлиНеопределено("name")
            и Библиотека.ПолучитьИлиНеопределено("version") == Селектор.ПолучитьИлиНеопределено("version")
            если Выбранная != Неопределено
                возврат Неопределено
            ;
            Выбранная = ОбъектЗначение(Библиотека.ПолучитьИлиНеопределено("model"))
        ;
    ;
    возврат Выбранная
;

метод Проверить(Модель: Соответствие<Строка, Объект?>, Проверка: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>
    знч МодельПроверки = ВыбратьМодельПроверки(Модель, Проверка)
    если МодельПроверки == Неопределено
        возврат {"status": "ERROR", "reasonCode": "invalid_test", "message": "Указанная библиотека не найдена или неоднозначна"}
    ;
    знч Вид = Проверка.ПолучитьИлиНеопределено("type") как Строка
    если Вид == "runtime"
        // Фактический результат из изолированного Script executor. Сравнение — здесь.
        знч Исполнение = ОбъектЗначение(Проверка.ПолучитьИлиНеопределено("execution"))
        если Исполнение.ПолучитьИлиНеопределено("status") != "EXECUTED"
            возврат {"status": Исполнение.ПолучитьИлиНеопределено("status"), "message": Исполнение.ПолучитьИлиНеопределено("message"), "reasonCode": Исполнение.ПолучитьИлиНеопределено("reasonCode")}
        ;
        если Проверка.ПолучитьИлиНеопределено("generative") != Неопределено
            возврат ПроверитьИнвариант(ОбъектЗначение(Проверка.Получить("generative")), ОбъектЗначение(Исполнение.Получить("actual")))
        ;
        пер Ожидается = Проверка.ПолучитьИлиНеопределено("expected")
        если Проверка.ПолучитьИлиНеопределено("clockOracle") != Неопределено
            // Independent teacher contract. Clock evidence is captured before student calls.
            знч Часы = Исполнение.ПолучитьИлиНеопределено("clock")
            если Часы == Неопределено
                возврат {"status": "ERROR", "reasonCode": "execution_error", "message": "Нет Docker-снимка часов"}
            ;
            Ожидается = ОжиданияЧасов(Ожидается, ОбъектЗначение(Часы), ОбъектЗначение(Проверка.Получить("clockOracle")))
        ;
        если Проверка.ПолучитьИлиНеопределено("runtimeDateTime") != Неопределено
            // Snapshot taken in Docker before invoking the handler, independent of its result.
            знч ВремяТеста = Исполнение.ПолучитьИлиНеопределено("runtimeDateTime")
            если ВремяТеста == Неопределено
                возврат {"status": "ERROR", "reasonCode": "execution_error", "message": "Runtime не вернул дату теста"}
            ;
            знч Шаблон = СериализацияJson.ЗаписатьОбъект(Ожидается)
            Ожидается = СериализацияJson.ПрочитатьОбъект(Шаблон.Заменить(
                СериализацияJson.ЗаписатьОбъект("__runtimeDateTime__"), СериализацияJson.ЗаписатьОбъект(ВремяТеста)))
        ;
        знч Фактически = Исполнение.ПолучитьИлиНеопределено("actual")
        знч Сравнение = Проверка.ПолучитьИлиНеопределено("comparison")
        если Сравнение != Неопределено и Сравнение != "record-sets-unordered" и Сравнение != "query-rows-unordered"
            возврат {"status": "ERROR", "reasonCode": "invalid_test", "message": "Неизвестный режим comparison"}
        ;
        знч Совпало = Сравнение == "record-sets-unordered" или Сравнение == "query-rows-unordered" ? СравнитьХранилище(Ожидается, Фактически, Сравнение == "query-rows-unordered") : Ожидается == Фактически
        возврат {"status": Совпало ? "PASS" : "FAIL", "expected": Ожидается, "actual": Фактически}
    ;
    если Вид == "module" или Вид == "method"
        знч Модуль = НайтиМодуль(МодельПроверки, Проверка.ПолучитьИлиНеопределено("module") как Строка, Проверка.ПолучитьИлиНеопределено("namespace"))
        если Модуль == Неопределено
            возврат {"status": Проверка.ПолучитьИлиНеопределено("exists") == Ложь ? "PASS" : "FAIL", "message": "Модуль не найден"}
        ;
        если Вид == "module"
            если Проверка.ПолучитьИлиНеопределено("exists") == Ложь
                возврат {"status": "FAIL", "message": "Модуль должен отсутствовать"}
            ;
            возврат {"status": "PASS"}
        ;
        знч Метод = Найти(Модуль.ПолучитьИлиНеопределено("methods"), Проверка.ПолучитьИлиНеопределено("name") как Строка, "name")
        если Метод == Неопределено
            если Модуль.ПолучитьИлиНеопределено("indexComplete") != Истина
                возврат {"status": "UNSUPPORTED", "reasonCode": "unsupported_syntax", "message": "Отсутствие метода не доказано: индекс модуля неполон"}
            ;
            возврат {"status": Проверка.ПолучитьИлиНеопределено("exists") == Ложь ? "PASS" : "FAIL", "message": "Метод не найден в индексе"}
        ;
        если Проверка.ПолучитьИлиНеопределено("exists") == Ложь
            возврат {"status": "FAIL", "message": "Метод должен отсутствовать"}
        ;
        для Аннотация из МассивЗначений(Проверка.ПолучитьИлиНеопределено("annotations"))
            если не МассивЗначений(Метод.ПолучитьИлиНеопределено("annotations")).Содержит(Аннотация)
                возврат {"status": "FAIL", "message": "Не найдена аннотация", "expected": Аннотация}
            ;
        ;
        если Проверка.ПолучитьИлиНеопределено("parameterCount") != Неопределено и Проверка.ПолучитьИлиНеопределено("parameterCount") != МассивЗначений(Метод.ПолучитьИлиНеопределено("parameters")).Размер()
            возврат {"status": "FAIL", "message": "Количество параметров не совпадает", "expected": Проверка.ПолучитьИлиНеопределено("parameterCount"), "actual": МассивЗначений(Метод.ПолучитьИлиНеопределено("parameters")).Размер()}
        ;
        если Проверка.ПолучитьИлиНеопределено("returnType") != Неопределено и Проверка.ПолучитьИлиНеопределено("returnType") != Метод.ПолучитьИлиНеопределено("returnType")
            возврат {"status": "FAIL", "message": "Тип результата не совпадает", "expected": Проверка.ПолучитьИлиНеопределено("returnType"), "actual": Метод.ПолучитьИлиНеопределено("returnType")}
        ;
        для Параметр из МассивЗначений(Проверка.ПолучитьИлиНеопределено("parameters"))
            знч Ожидаемый = ОбъектЗначение(Параметр)
            знч Фактический = Найти(Метод.ПолучитьИлиНеопределено("parameters"), Ожидаемый.ПолучитьИлиНеопределено("name") как Строка, "name")
            если Фактический == Неопределено или Фактический.ПолучитьИлиНеопределено("type") != Ожидаемый.ПолучитьИлиНеопределено("type")
                возврат {"status": "FAIL", "message": "Сигнатура параметра не совпадает", "expected": Ожидаемый, "actual": Фактический}
            ;
        ;
        возврат {"status": "PASS"}
    ;
    если Вид != "element" и Вид != "field" и Вид != "tableSection" и Вид != "enumValue"
        возврат {"status": "UNSUPPORTED", "reasonCode": "unsupported_contract", "message": "Вид проверки пока не поддерживается: ${Вид}"}
    ;
    знч Имя = (Вид == "element" ? Проверка.ПолучитьИлиНеопределено("name") : Проверка.ПолучитьИлиНеопределено("element")) как Строка
    знч Части = Имя.Разделить(".")
    знч Элемент = НайтиЭлемент(МодельПроверки, Части[0])
    если Элемент == Неопределено
        возврат {"status": Проверка.ПолучитьИлиНеопределено("exists") == Ложь ? "PASS" : "FAIL", "message": "Элемент не найден: ${Имя}"}
    ;
    пер Свойства = ОбъектЗначение(Элемент.ПолучитьИлиНеопределено("properties"))
    если Части.Размер() > 1
        знч Таблица = Найти(Свойства.ПолучитьИлиНеопределено("ТабличныеЧасти"), Части[1])
        если Таблица == Неопределено
            возврат {"status": "FAIL", "message": "Табличная часть не найдена: ${Имя}"}
        ;
        Свойства = Таблица
    ;
    если Вид == "element"
        если Проверка.ПолучитьИлиНеопределено("exists") == Ложь
            возврат {"status": "FAIL", "message": "Элемент должен отсутствовать"}
        ;
        если Проверка.ПолучитьИлиНеопределено("elementType") != Неопределено и Проверка.ПолучитьИлиНеопределено("elementType") != Элемент.ПолучитьИлиНеопределено("elementType")
            возврат {"status": "FAIL", "message": "Вид элемента не совпадает", "expected": Проверка.ПолучитьИлиНеопределено("elementType"), "actual": Элемент.ПолучитьИлиНеопределено("elementType")}
        ;
    иначе
        пер Член: Соответствие<Строка, Объект?>?
        если Вид == "tableSection"
            Член = Найти(Свойства.ПолучитьИлиНеопределено("ТабличныеЧасти"), Проверка.ПолучитьИлиНеопределено("name") как Строка)
        иначе если Вид == "enumValue"
            Член = Найти(Свойства.ПолучитьИлиНеопределено("Элементы"), Проверка.ПолучитьИлиНеопределено("name") как Строка)
        иначе
            знч Группа = Проверка.ПолучитьИлиНеопределено("collection") == Неопределено ? "Реквизиты" : Проверка.ПолучитьИлиНеопределено("collection") как Строка
            если Группа != "Реквизиты" и Группа != "Измерения" и Группа != "Ресурсы" и Группа != "Константы"
                возврат {"status": "ERROR", "reasonCode": "invalid_test", "message": "Неизвестная коллекция реквизитов: ${Группа}"}
            ;
            если Проверка.ПолучитьИлиНеопределено("collection") == Неопределено
                для ДругаяГруппа из ["Измерения", "Ресурсы", "Константы"]
                    если Найти(Свойства.ПолучитьИлиНеопределено(ДругаяГруппа), Проверка.ПолучитьИлиНеопределено("field") как Строка) != Неопределено и Найти(Свойства.ПолучитьИлиНеопределено("Реквизиты"), Проверка.ПолучитьИлиНеопределено("field") как Строка) != Неопределено
                        возврат {"status": "ERROR", "reasonCode": "invalid_test", "message": "Реквизит встречается в нескольких коллекциях; укажите collection"}
                    ;
                ;
            ;
            Член = Найти(Свойства.ПолучитьИлиНеопределено(Группа), Проверка.ПолучитьИлиНеопределено("field") как Строка)
        ;
        если Член == Неопределено
            возврат {"status": Проверка.ПолучитьИлиНеопределено("exists") == Ложь ? "PASS" : "FAIL", "message": "Член элемента не найден"}
        ;
        если Проверка.ПолучитьИлиНеопределено("exists") == Ложь
            возврат {"status": "FAIL", "message": "Член элемента должен отсутствовать"}
        ;
        Свойства = Член
        если Проверка.ПолучитьИлиНеопределено("expectedType") != Неопределено и Проверка.ПолучитьИлиНеопределено("expectedType") != Свойства.ПолучитьИлиНеопределено("Тип")
            возврат {"status": "FAIL", "message": "Тип члена не совпадает", "expected": Проверка.ПолучитьИлиНеопределено("expectedType"), "actual": Свойства.ПолучитьИлиНеопределено("Тип")}
        ;
    ;
    знч Несовпадение = ПроверитьСвойства(Проверка, Свойства)
    если Несовпадение != Неопределено
        возврат Несовпадение
    ;
    возврат {"status": "PASS"}
;

// A standalone oracle uses explicit calendar labels and the teacher's workweek.
// It never reads greeting, labels, or date inputs from the student's actual result.
метод ОжиданияЧасов(Шаблон: Объект?, Часы: Соответствие<Строка, Объект?>, Контракт: Соответствие<Строка, Объект?>): Объект?
    знч С = новый ДатаВремя(Часы.Получить("snapshot") как Строка)
    знч Д = новый Дата(С.Год, С.Месяц, С.День)
    знч В = новый Время(С.Час, С.Минута, С.Секунда, С.Миллисекунда)
    знч День = Д.ДеньНедели()
    знч Имена = ["Понедельник", "Вторник", "Среда", "Четверг", "Пятница", "Суббота", "Воскресенье"]
    знч Дни = [ДеньНедели.Понедельник, ДеньНедели.Вторник, ДеньНедели.Среда, ДеньНедели.Четверг, ДеньНедели.Пятница, ДеньНедели.Суббота, ДеньНедели.Воскресенье]
    пер Имя = ""
    для И = 0 по 6
        если День == Дни[И]
            Имя = Имена[И]
        ;
    ;
    знч Приветствия = МассивЗначений(Контракт.Получить("greetings"))
    знч Приветствие = Приветствия[С.Час < 6 ? 0 : (С.Час < 12 ? 1 : (С.Час < 18 ? 2 : 3))]
    знч Неделя = ОбъектЗначение(Контракт.Получить("workWeek"))
    знч ТипДня = "Сегодня: " + Имя + (Неделя.Получить(Имя) == Истина ? " — рабочий день" : " — выходной день")
    знч Замены = {"__clock.date__": Д.ВСтроку(), "__clock.timeText__": (Контракт.Получить("timePrefix") как Строка) + ": " + В.Представление("ЧЧ:мм:сс"), "__clock.dayText__": ТипДня, "__clock.greeting__": Приветствие}
    пер Текст = СериализацияJson.ЗаписатьОбъект(Шаблон)
    для Пара из Замены
        Текст = Текст.Заменить(СериализацияJson.ЗаписатьОбъект(Пара.Ключ), СериализацияJson.ЗаписатьОбъект(Пара.Значение))
    ;
    возврат СериализацияJson.ПрочитатьОбъект(Текст)
;

// Independent multiset comparison: no sorting or business formula in Python.
метод СравнитьМножество(А: Массив<Объект?>, Б: Массив<Объект?>): Булево
    если А.Размер() != Б.Размер()
        возврат Ложь
    ;
    знч Осталось = новый Массив<Объект?>(Б)
    для Строка из А
        пер Индекс = -1
        для И = 0 по Осталось.Размер() - 1
            если Осталось[И] == Строка
                Индекс = И
                прервать
            ;
        ;
        если Индекс < 0
            возврат Ложь
        ;
        Осталось.УдалитьПоИндексу(Индекс)
    ;
    возврат Осталось.Пусто()
;

метод СравнитьНаблюденияЗапроса(А: Объект?, Б: Объект?): Булево
    если А это Массив<Объект?> и Б это Массив<Объект?>
        возврат СравнитьМножество(А как Массив<Объект?>, Б как Массив<Объект?>)
    ;
    если не (А это Соответствие<Строка, Объект?>) или не (Б это Соответствие<Строка, Объект?>)
        возврат Ложь
    ;
    знч О = ОбъектЗначение(А)
    знч Ф = ОбъектЗначение(Б)
    если О.Размер() == 1 и Ф.Размер() == 1 и О.СодержитКлюч("actions") и Ф.СодержитКлюч("actions")
        если не (О["actions"] это Массив<Объект?>) или не (Ф["actions"] это Массив<Объект?>)
            возврат Ложь
        ;
        знч ОД = О["actions"] как Массив<Объект?>
        знч ФД = Ф["actions"] как Массив<Объект?>
        если ОД.Размер() != ФД.Размер()
            возврат Ложь
        ;
        для И = 0 по ОД.Размер() - 1
            если не СравнитьНаблюденияЗапроса(ОД[И], ФД[И])
                возврат Ложь
            ;
        ;
        возврат Истина
    ;
    если О.Размер() != 4 или Ф.Размер() != 4 или
        не О.СодержитКлюч("rows") или не Ф.СодержитКлюч("rows") или
        не О.СодержитКлюч("cardinality") или не Ф.СодержитКлюч("cardinality") или
        не О.СодержитКлюч("columns") или не Ф.СодержитКлюч("columns") или
        не О.СодержитКлюч("resource") или не Ф.СодержитКлюч("resource") или
        не (О["rows"] это Массив<Объект?>) или не (Ф["rows"] это Массив<Объект?>)
        возврат Ложь
    ;
    возврат О["cardinality"] == Ф["cardinality"] и О["columns"] == Ф["columns"] и О["resource"] == Ф["resource"] и
        СравнитьМножество(О["rows"] как Массив<Объект?>, Ф["rows"] как Массив<Объект?>)
;

метод СравнитьХранилище(А: Объект?, Б: Объект?, СтрокиЗапроса: Булево = Ложь): Булево
    знч Ожидается = ОбъектЗначение(А)
    знч Фактически = ОбъектЗначение(Б)
    если Ожидается.Размер() != 2 или Фактически.Размер() != 2 или
        не Ожидается.СодержитКлюч("result") или не Фактически.СодержитКлюч("result") или
        не Ожидается.СодержитКлюч("storage") или не Фактически.СодержитКлюч("storage")
        возврат Ложь
    ;
    если СтрокиЗапроса
        если не СравнитьНаблюденияЗапроса(Ожидается["result"], Фактически["result"])
            возврат Ложь
        ;
    иначе если Ожидается["result"] != Фактически["result"]
        возврат Ложь
    ;
    знч О = МассивЗначений(Ожидается["storage"])
    знч Ф = МассивЗначений(Фактически["storage"])
    если О.Размер() != Ф.Размер()
        возврат Ложь
    ;
    знч Осталось = новый Массив<Объект?>(Ф)
    для Элемент из О
        знч Запись = ОбъектЗначение(Элемент)
        пер Найдено = Ложь
        для И = 0 по Осталось.Размер() - 1
            знч Другая = ОбъектЗначение(Осталось[И])
            если Запись.Размер() != 3 или Другая.Размер() != 3 или
                Запись.ПолучитьИлиНеопределено("type") != Другая.ПолучитьИлиНеопределено("type") или
                Запись.ПолучитьИлиНеопределено("id") != Другая.ПолучитьИлиНеопределено("id")
                продолжить
            ;
            знч АЗ = Запись.ПолучитьИлиНеопределено("value")
            знч БЗ = Другая.ПолучитьИлиНеопределено("value")
            если АЗ это Массив<Объект?> и БЗ это Массив<Объект?>
                Найдено = СравнитьМножество(АЗ как Массив<Объект?>, БЗ как Массив<Объект?>)
            иначе
                Найдено = АЗ == БЗ
            ;
            если Найдено
                Осталось.УдалитьПоИндексу(И)
                прервать
            ;
        ;
        если не Найдено
            возврат Ложь
        ;
    ;
    возврат Осталось.Пусто()
;

метод ВыполнитьПроверки(Модель: Соответствие<Строка, Объект?>, Задание: Соответствие<Строка, Объект?>): Соответствие<Строка, Объект?>
    знч Результаты = новый Массив<Объект?>()
    пер Баллы = 0
    пер Максимум = 0
    пер НедоступныеБаллы = 0
    пер Ошибки = 0
    пер Неполно = Ложь
    для Значение из МассивЗначений(Задание.ПолучитьИлиНеопределено("checks"))
        знч Проверка = ОбъектЗначение(Значение)
        пер Результат: Соответствие<Строка, Объект?>
        если Проверка.ПолучитьИлиНеопределено("skip") == Истина
            Результат = {"status": "SKIPPED"}
        иначе
            попытка
                Результат = Проверить(Модель, Проверка)
            поймать Ошибка: Исключение
                Результат = {"status": "ERROR", "message": "${Ошибка}"}
            ;
        ;
        знч Вес = Проверка.ПолучитьИлиНеопределено("points") как Число
        пер Статус = Результат.ПолучитьИлиНеопределено("status")
        если Статус != "PASS" и Статус != "FAIL" и Статус != "ERROR" и Статус != "TIMEOUT" и Статус != "UNSUPPORTED" и Статус != "SKIPPED"
            Статус = "ERROR"
            Результат.Вставить("status", Статус)
            Результат.Вставить("message", "Неизвестный статус исполнения")
            Результат.Вставить("reasonCode", "execution_error")
        ;
        если Статус != "PASS" и Результат.ПолучитьИлиНеопределено("reasonCode") == Неопределено
            Результат.Вставить("reasonCode", Статус == "FAIL" ? "result_mismatch" :
                (Статус == "TIMEOUT" ? "timeout" : (Статус == "SKIPPED" ? "skipped" :
                (Статус == "UNSUPPORTED" ? "unsupported_contract" : "execution_error"))))
        ;
        Результат.Вставить("id", Проверка.ПолучитьИлиНеопределено("id"))
        если Статус == "FAIL" и Проверка.ПолучитьИлиНеопределено("failureExplanation") != Неопределено
            Результат.Вставить("failureExplanation", Проверка.ПолучитьИлиНеопределено("failureExplanation"))
        ;
        если Проверка.ПолучитьИлиНеопределено("group") != Неопределено
            Результат.Вставить("group", Проверка.ПолучитьИлиНеопределено("group"))
        ;
        если Проверка.ПолучитьИлиНеопределено("integration") != Неопределено и Проверка.ПолучитьИлиНеопределено("execution") != Неопределено
            знч Исполнение = ОбъектЗначение(Проверка.ПолучитьИлиНеопределено("execution"))
            Результат.Вставить("integration", Исполнение.ПолучитьИлиНеопределено("integration"))
        ;
        Результат.Вставить("points", Вес)
        Результат.Вставить("score", Статус == "PASS" ? Вес : 0)
        если Статус == "UNSUPPORTED" или Статус == "SKIPPED" или Статус == "ERROR" или Статус == "TIMEOUT"
            НедоступныеБаллы += Вес
            Неполно = Истина
        иначе
            Максимум += Вес
            если Статус == "PASS"
                Баллы += Вес
            иначе
                Ошибки += 1
            ;
        ;
        Результаты.Добавить(Результат)
    ;
    возврат {"schemaVersion": 1, "project": Модель.ПолучитьИлиНеопределено("name"), "sourceHash": Модель.ПолучитьИлиНеопределено("sourceHash"),
        "status": Ошибки > 0 ? "failed" : (Неполно ? "incomplete" : "passed"),
        "score": Баллы, "maxScore": Максимум, "unavailablePoints": НедоступныеБаллы,
        "checks": Результаты, "diagnostics": Модель.ПолучитьИлиНеопределено("diagnostics")}
;
