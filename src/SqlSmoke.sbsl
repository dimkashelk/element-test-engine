// Trusted infrastructure only. Never imports a student module or executes supplied SQL.
метод Записать(Соединение: СоединениеSql, Набор: Строка, Товар: Строка, Склад: Строка, Количество: Число): Число
    знч Запрос = Соединение.СоздатьЗапросБезВыборки(
        "INSERT INTO smoke.stock(dataset, item, warehouse, quantity) VALUES (&dataset, &item, &warehouse, &quantity)")
    Запрос.УстановитьЗначениеПараметра("dataset", Набор)
    Запрос.УстановитьЗначениеПараметра("item", Товар)
    Запрос.УстановитьЗначениеПараметра("warehouse", Склад)
    Запрос.УстановитьЗначениеПараметра("quantity", Количество)
    возврат Запрос.Выполнить()
;

метод Прочитать(Соединение: СоединениеSql, Набор: Строка, Склад: Строка): Массив<Объект>
    знч Запрос = Соединение.СоздатьЗапросСВыборкой(
        "SELECT item, quantity FROM smoke.stock WHERE dataset = &dataset AND warehouse = &warehouse ORDER BY item")
    Запрос.УстановитьЗначениеПараметра("dataset", Набор)
    Запрос.УстановитьЗначениеПараметра("warehouse", Склад)
    исп Выборка = Запрос.Выполнить()
    знч Строки = новый Массив<Объект>()
    пока Выборка.Следующий()
        Строки.Добавить({"item": Выборка.Получить("item"), "quantity": Выборка.Получить("quantity")})
    ;
    возврат Строки
;

метод Скрипт(ПутьКонфигурации: Строка)
    попытка
        исп Поток = новый Файл(ПутьКонфигурации).ОткрытьПотокЧтения()
        знч Конфигурация = СериализацияJson.ПрочитатьСоответствие(Поток.ПрочитатьКакСтроку())
        исп Соединение = новый СоединениеSql(Конфигурация["connection"] как Строка)
        знч Первый = Конфигурация["first"] как Строка
        знч Второй = Конфигурация["second"] как Строка
        исп НачальнаяВыборка = Соединение.СоздатьЗапросСВыборкой("SELECT count(*) AS total FROM smoke.stock").Выполнить()
        НачальнаяВыборка.Следующий()
        знч ВсегоДо = НачальнаяВыборка.Получить("total")
        исп Права = Соединение.СоздатьЗапросСВыборкой(
            "SELECT rolsuper, rolcreatedb, rolcreaterole FROM pg_roles WHERE rolname = current_user").Выполнить()
        Права.Следующий()
        знч Привилегии = {"superuser": Права.Получить("rolsuper"), "createDb": Права.Получить("rolcreatedb"), "createRole": Права.Получить("rolcreaterole")}
        знч ПустоДо = Прочитать(Соединение, Первый, "main")
        пер Записано = Записать(Соединение, Первый, "a", "main", 1.25)
        Записано += Записать(Соединение, Первый, "b", "main", 2.5)
        Записано += Записать(Соединение, Первый, "a", "other", 99.75)
        Записано += Записать(Соединение, Второй, "a", "main", 7.125)
        знч До = Прочитать(Соединение, Первый, "main")
        знч Независимый = Прочитать(Соединение, Второй, "main")
        знч ДругойСклад = Прочитать(Соединение, Первый, "other")
        если Конфигурация["injectFailure"] как Булево
            // Fail after committed writes; Python must still destroy this run's DB.
            Соединение.СоздатьЗапросБезВыборки("INSERT INTO smoke.missing VALUES (1)").Выполнить()
        ;
        знч Изменение = Соединение.СоздатьЗапросБезВыборки(
            "UPDATE smoke.stock SET quantity = &quantity WHERE dataset = &dataset AND item = &item AND warehouse = &warehouse")
        Изменение.УстановитьЗначениеПараметра("quantity", 3.375)
        Изменение.УстановитьЗначениеПараметра("dataset", Первый)
        Изменение.УстановитьЗначениеПараметра("item", "a")
        Изменение.УстановитьЗначениеПараметра("warehouse", "main")
        знч Изменено = Изменение.Выполнить()
        знч После = Прочитать(Соединение, Первый, "main")
        знч НезависимыйПосле = Прочитать(Соединение, Второй, "main")
        знч Удалено = Соединение.СоздатьЗапросБезВыборки("DELETE FROM smoke.stock").Выполнить()
        знч ПустоПосле = Прочитать(Соединение, Первый, "main")
        знч ВторойПустоПосле = Прочитать(Соединение, Второй, "main")
        исп КонечнаяВыборка = Соединение.СоздатьЗапросСВыборкой("SELECT count(*) AS total FROM smoke.stock").Выполнить()
        КонечнаяВыборка.Следующий()
        знч ВсегоПосле = КонечнаяВыборка.Получить("total")
        Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"status": "EXECUTED", "actual": {
            "before": ПустоДо, "inserted": Записано, "first": До, "second": Независимый,
            "otherWarehouse": ДругойСклад, "updated": Изменено, "after": После,
            "secondAfter": НезависимыйПосле, "deleted": Удалено,
            "emptyAfter": ПустоПосле, "secondEmptyAfter": ВторойПустоПосле,
            "initialCount": ВсегоДо, "remainingCount": ВсегоПосле, "privileges": Привилегии}}))
    поймать Ошибка: Исключение
        // Driver exceptions can contain credentials. Export only the trusted category.
        Консоль.Записать(СериализацияJson.ЗаписатьОбъект({"status": "ERROR", "message": "SQL smoke: ошибка выполнения запроса"}))
    ;
;
